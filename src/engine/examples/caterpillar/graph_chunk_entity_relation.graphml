<node id="&quot;THIRD AMENDED AND RESTATED CREDIT AGREEMENT&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"The Third Amended and Restated Credit Agreement serves as the foundational contract for the Borrowers' financial arrangements."</data>
