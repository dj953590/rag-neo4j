<node id="&quot;EVENT OF DEFAULT&quot;">
  <data key="d0">"COVENANT"</data>
  <data key="d1">"A condition that would result in default concerning the Borrower, indicating a breach of terms."&lt;SEP&gt;"An Event of Default refers to a situation where the Borrowers fail to meet their obligations under the Amended Credit Agreement."</data>
  <data key="d2">chunk-58598f70b5a253429401f1f1c4a79734&lt;SEP&gt;chunk-4fdadc02546029dea7800ee5f9c31dc1</data>
