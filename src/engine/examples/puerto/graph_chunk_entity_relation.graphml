</node>
<node id="&quot;ADMINISTRATOR&quot;">
  <data key="d0">"AGENT"</data>
  <data key="d1">"The entity responsible for managing the trust's assets and ensuring compliance with the terms of the agreement."</data>
  <data key="d2">chunk-b53aa3032d7724a08ebc102d9b31f54173425439d5eff944136fbb26b5aa2110</data>
