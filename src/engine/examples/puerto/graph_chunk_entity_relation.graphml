</edge>
<edge source="&quot;PARENT COMPANY&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">10.0</data>
  <data key="d5">"The Parent Company owns or controls the Borrower, indicating a hierarchical business structure."</data>
  <data key="d6">"Ownership, Control"</data>
