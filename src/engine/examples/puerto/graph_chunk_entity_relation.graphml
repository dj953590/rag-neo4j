  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PERSON&quot;" target="&quot;INDEBTEDNESS&quot;">
  <data key="d4">14.0</data>
  <data key="d5">"The Indebtedness of a Person incorporates all liabilities they're liable for, including those from personal ownership interests in other entities."&lt;SEP&gt;"The term Person includes entities that can incur Indebtedness under the Agreement."</data>
  <data key="d6">"Legal Entity"&lt;SEP&gt;"Obligor, Financial Responsibility"</data>
  <data key="d7">chunk-fa0678d958db442fcb1252228bf16e5bad67dc5abb758474a551ca176e51e721&lt;SEP&gt;chunk-0aae36cc9f3bd8d010bf4d399d95a5d5d1128b238b823cbd73a39e5d17e90a77</data>
