</edge>
<edge source="&quot;SECURITY TRUSTEE&quot;" target="&quot;LIEN&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Security Trustee manages the Lien on collateral securing the loan provided to the Borrower."</data>
  <data key="d6">"collateral management"</data>
