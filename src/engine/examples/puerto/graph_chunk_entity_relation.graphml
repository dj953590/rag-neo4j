  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LIEN&quot;" target="&quot;BANK&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Bank holds a Lien against the Borrower’s assets as a security for the loan."</data>
  <data key="d6">"security interest"</data>
  <data key="d7">chunk-d08330e624b008011709b83b5a2c8cb88d4036d409681528bf5227b76772566b</data>
