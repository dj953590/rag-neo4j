</node>
<node id="&quot;OPERATING ACCOUNT&quot;">
  <data key="d0">"BANK ACCOUNT"</data>
  <data key="d1">"Account #0400015155 established by the Borrower with the Bank exclusively for use in connection with this Agreement."&lt;SEP&gt;"The Operating Account is maintained by the Borrower to ensure sufficient funds to cover interest payment obligations under the credit agreement."</data>
  <data key="d2">chunk-228c502c8880a404029e4a01d826cc4e22cf95111ea9fdd014095cae26e5c434&lt;SEP&gt;chunk-c801681ae7db2c79dc705328d1eff621b1067f2817a730b578f231984615295f</data>
