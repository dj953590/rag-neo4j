  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LIBOR FLOATING POOL RATE&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrower pays interest on Advances calculated based on the LIBOR Floating Pool Rate plus the Applicable Spread."</data>
  <data key="d6">"interest calculation"</data>
  <data key="d7">chunk-1ec14b1a14c93b7acdcda9750eadec1907007f2b8e4c45de9fd3cbd7b3185719</data>
