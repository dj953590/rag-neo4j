</edge>
<edge source="&quot;SPECIAL COUNSEL&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Borrower may appoint Special Counsel to assist in legal matters related to the financing."&lt;</data>
  <data key="d6">"appointment, advisory"&lt;</data>
  <data key="d7">chunk-2630b7f24a2555aecd7c3d3b01bcf5e14541b13c1919513f1b14b1a56b40f016</data>
