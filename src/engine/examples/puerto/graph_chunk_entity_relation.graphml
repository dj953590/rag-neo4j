</node>
<node id="&quot;INSTRUMENTS&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Instruments refer to any formal documents or contracts associated with the Borrower that may play a role in its financial and legal relationships."</data>
  <data key="d2">chunk-c82b10a8831e936d119a7b8bae39d0b793e1042b00dc9b4257147b5151c8c9a6</data>
