  <data key="d0">"COURT"</data>
  <data key="d1">"The Southern District of New York is a federal court jurisdiction dealing with various legal matters, including those arising from credit agreements."</data>
  <data key="d2">chunk-e0698bc3602d3fa5329accd914b55b61d6fca91548227dcb8b192769cff1a41f</data>
