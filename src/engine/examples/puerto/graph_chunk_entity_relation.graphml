  <data key="d0">"SCHEDULE"</data>
  <data key="d1">"Puerto Rico Time refers to the specific time zone relevant to the Borrower's notification provisions regarding prepayments."</data>
  <data key="d2">chunk-1ec14b1a14c93b7acdcda9750eadec1907007f2b8e4c45de9fd3cbd7b3185719</data>
