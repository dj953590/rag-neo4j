  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;COST TO THE BANK&quot;" target="&quot;BANK&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The financial impact on the Bank resulting from Events necessitating adjustments to the amounts due from the Borrower."</data>
  <data key="d6">"financial impact"</data>
  <data key="d7">chunk-1153d2ce9781f421ef9f8a96cfad97b1d0733ca1ff10f84a402988b66edf1e41</data>
