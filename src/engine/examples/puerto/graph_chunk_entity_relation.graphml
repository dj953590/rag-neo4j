<node id="&quot;EQUITY INTERESTS&quot;">
  <data key="d0">"COLLATERAL"</data>
  <data key="d1">"Ownership interests in the Subsidiaries that may be declared and paid as dividends."&lt;SEP&gt;"Shares of capital stock, partnership interests, membership interests in a limited liability company, beneficial interests in a trust or other equity ownership interests, and any warrants, options or other rights entitling the holder to purchase or acquire such equity interest."</data>
  <data key="d2">chunk-08cef172c2592d496e50f2cf885901cae232a13897063fc83b0e4da5506e053e&lt;SEP&gt;chunk-feafca318473c2316c5b5fbb760515cfce14f9fecabeefd14d3004dd70bf2767</data>
