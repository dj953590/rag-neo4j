</node>
<node id="&quot;INTERNAL REVENUE SERVICE&quot;">
  <data key="d0">"GOVERNMENTAL AUTHORITY"</data>
  <data key="d1">"The U.S. federal agency responsible for tax collection and tax law enforcement, relevant to the Borrower's need to file Form 8038-G."</data>
  <data key="d2">chunk-bb356deeb3d4c5fb5ce8f06a814fbadd22e30c5fa7d0ecc40d7e10362fd8b2dc</data>
