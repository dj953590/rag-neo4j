  <data key="d0">"LEGAL TERMS"</data>
  <data key="d1">"These terms denote the processes the Borrower may engage in regarding corporate restructuring and are permitted under certain conditions in the agreement."</data>
  <data key="d2">chunk-c4f37ef461fd5888168e939fb3f4581ccf94e805b763a6b1d095fa068bf8d659</data>
