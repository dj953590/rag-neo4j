</node>
<node id="&quot;FOREIGN BANK&quot;">
  <data key="d0">"BANK"</data>
  <data key="d1">"A financial institution that is entitled to an exemption from withholding tax under applicable laws concerning payments made under the agreement."&lt;SEP&gt;"any bank that is organized under the laws of a jurisdiction other than that in which the Borrower is located."</data>
  <data key="d2">chunk-fa0678d958db442fcb1252228bf16e5bad67dc5abb758474a551ca176e51e721&lt;SEP&gt;chunk-dc2ba336c239569c1217438ac6133ac1cd66c12d79fbebe344ab54ad5c78da35</data>
