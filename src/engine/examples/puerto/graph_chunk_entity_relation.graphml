  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PERSON&quot;" target="&quot;GUARANTEES&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"A Person may provide Guarantees to cover the Indebtedness of another party, serving to underline their financial responsibilities and obligations."</data>
  <data key="d6">"Obligor, Guarantor"</data>
  <data key="d7">chunk-0aae36cc9f3bd8d010bf4d399d95a5d5d1128b238b823cbd73a39e5d17e90a77</data>
  <data key="d8">DOC-d78f3a912cf6a0d022b78fa6955d54764af5f4e9ad6a1aef69147ba45f381b9c</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PERSON&quot;" target="&quot;RELATED PARTIES&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Related Parties encompass the affiliates and representatives associated with any Person involved in a transaction."</data>
  <data key="d6">"affiliation"</data>
