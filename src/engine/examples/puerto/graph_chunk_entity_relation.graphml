</edge>
<edge source="&quot;FACILITY AMOUNT&quot;" target="&quot;AVAILABLE AMOUNT&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Available Amount is calculated based on the Facility Amount minus the Aggregate Advances, indicating the available credit."|&gt;"financial calculation"</data>
