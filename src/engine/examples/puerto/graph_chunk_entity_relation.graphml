  <data key="d0">"OBLIGOR"</data>
  <data key="d1">"Josue Antonio Colon Ortiz is the Acting Executive Director of the Puerto Rico Electric Power Authority and serves as an obligor in the credit agreement."</data>
  <data key="d2">chunk-6c4187c4c97cb9c42f524362397c7bbedcd1ace1fe2352097eca90b08e8f3b90</data>
