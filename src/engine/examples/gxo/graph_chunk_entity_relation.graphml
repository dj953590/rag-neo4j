  <data key="d3">DOC-236032ad52b5c77d76ca8b5b9d3ee21fa9d36f49e15211204ee2de8f5df0e70a</data>
</node>
<node id="&quot;COLLATERAL&quot;">
  <data key="d0">"COLLATERAL"</data>
  <data key="d1">"Assets or property pledged by the borrower as security for the loan, which serve to reduce the lender's risk in the event of default."</data>
