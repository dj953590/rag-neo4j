  <data key="d2">chunk-e08590c6f860ab659cec13d7e2426aa7</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;SECTION 2.05(A)&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Specific clause in the agreement outlining entitlements regarding commitment fees."&lt;SEP&gt;"a specific section defining the 'Actual Unused Commitments' in the context of the agreement."</data>
  <data key="d2">chunk-fb44d7769bde7d6f8440869a5a341430&lt;SEP&gt;chunk-6bfb84ae77fdaa5e8c3a97e04c2e26f6</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;LIEN&quot;">
  <data key="d0">"LIEN"</data>
  <data key="d1">"The Lien refers to the legal right held by the Administrative Agent or Lenders over the Borrower's assets as collateral."&lt;SEP&gt;"a legal right or interest that a lender has in the borrower's assets until the debt obligation is satisfied."&lt;SEP&gt;"create or suffer to exist any Lien in or on any of its Property."</data>
  <data key="d2">chunk-904c0cc387dffe2b87a7d3f92f2a414f&lt;SEP&gt;chunk-35eafbdd125e44e090d5ed4a2ad20dd7&lt;SEP&gt;chunk-1dbc04f4bb02a514f3cd5a84a46dd521</data>
