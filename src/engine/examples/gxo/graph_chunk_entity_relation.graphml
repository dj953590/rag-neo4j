  <data key="d2">chunk-6486173d4e89e0b5a1e51ec7b8969261</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;OPERATING LEASE&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"A lease that is not capitalized on the balance sheet similar to Capitalized Leases, referenced in how obligations under leases are handled."</data>
  <data key="d2">chunk-051db1920040c63c8845f15fd1ebdf8f</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;FAILURE TO RESPOND&quot;">
  <data key="d0">"WAIVER"</data>
  <data key="d1">"Failure to respond refers to the scenario where a Lender or Issuing Lender does not provide a necessary consent in the specified time, leading to a default refusal for the loans."</data>
  <data key="d2">chunk-8ec8822f0ae2be723af299c5930b2ed8</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;PRICING LEVEL II&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The second tier of pricing in the commitment structure based on public debt ratings, influencing the applicable margin and fees."</data>
  <data key="d2">chunk-d48279d43f206b73878812648979f0eb</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;SECTION 6.01(B)&quot;">
  <data key="d0">"COVENANTS"</data>
  <data key="d1">"Another subsection in the agreement specifying the Borrower's obligation to provide particular types of financial statements."</data>
  <data key="d2">chunk-6486173d4e89e0b5a1e51ec7b8969261</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;JANUARY 31, 2018&quot;">
  <data key="d0">"EXECUTED DATE"</data>
  <data key="d1">"The date relevant for assessing compliance with operating leases as mentioned in the contract terms."&lt;SEP&gt;"The reference date for GAAP standards regarding lease accounting as mentioned in the context of the Agreement."</data>
  <data key="d2">chunk-6486173d4e89e0b5a1e51ec7b8969261&lt;SEP&gt;chunk-051db1920040c63c8845f15fd1ebdf8f</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;FOREIGN CURRENCY HEREUNDER&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"Foreign Currency hereunder designates the currency recognized as valid for loan advances and letters of credit, upon conformance with conditions."</data>
  <data key="d2">chunk-8ec8822f0ae2be723af299c5930b2ed8</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;PRICING LEVEL III&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The third tier of pricing applicable to the revolving credit agreement, influencing the commitment fee and margin based on credit ratings."</data>
  <data key="d2">chunk-d48279d43f206b73878812648979f0eb</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;GENERAL ACCEPTED ACCOUNTING PRINCIPLES (GAAP)&quot;">
  <data key="d0">"REGULATORY"</data>
  <data key="d1">"Framework of accounting standards governing the treatment of leases and obligations in the context of the Agreement."</data>
  <data key="d2">chunk-051db1920040c63c8845f15fd1ebdf8f</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
