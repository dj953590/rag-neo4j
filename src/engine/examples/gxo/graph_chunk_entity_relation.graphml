</node>
<node id="&quot;DEFERRED OR UNEARNED REVENUE&quot;">
  <data key="d0">"LIABILITY"</data>
  <data key="d1">"Revenue recognized before it is actually earned, affecting the financial position of the Borrower and its subsidiaries."</data>
  <data key="d2">chunk-c4a351a1361d1b2bab080245c9f7cfcbfe265cb6295dad3bae410e60d8a1bc32</data>
