  <data key="d1">"This signifies the formal request process whereby the Administrative Agent, Lender, or Issuing Lender can solicit payment from the Borrower regarding indemnification for taxes."</data>
  <data key="d2">chunk-064e1f22084ac500ab1a051f7b381aa4</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
