  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;EUROCURRENCY LOANS&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower may request Eurocurrency Loans in currencies approved by the Administrative Agent, which are subject to terms in the credit agreement."}&lt;SEP&gt;"The Borrower may take Advances in the form of Eurocurrency Loans, reflecting international lending practices."</data>
  <data key="d6">"loan type, funding"&lt;SEP&gt;"request"</data>
  <data key="d7">chunk-59684afb2e463574cf2aaf600c780e0debe3a298245661d942ad591b5ac883c0&lt;SEP&gt;chunk-84d7361cb1344ec6b34607e1ffa71f6fa5a0707b1c2af1350dabed4ef3eb78ba</data>
