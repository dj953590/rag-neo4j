  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"A specific clause within the agreement regarding compliance requirements for Lenders and Issuing Lenders."&lt;SEP&gt;"Provides provisions related to participants' rights and obligations in the Agreement."</data>
  <data key="d2">chunk-256b1931f6b1c4c3856140105237e337&lt;SEP&gt;chunk-bd9380e9db9ff5b3fc2108e49aa5e7d0</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;FUNDING&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The process of providing the necessary financial support related to loans and participations as detailed in the agreement."</data>
  <data key="d2">chunk-e08590c6f860ab659cec13d7e2426aa7</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
