<node id="&quot;UK FINANCIAL INSTITUTION&quot;">
  <data key="d0">"CORPORATION"</data>
  <data key="d1">"A financial institution regulated under UK financial laws."&lt;SEP&gt;"Defined under BRRD Undertaking and includes credit institutions, investment firms, and their affiliates, as per UK financial regulation."&lt;SEP&gt;"Refers to any financial institution operating under UK jurisdiction that may be subject to bail-in provisions."&lt;SEP&gt;"financial institutions that operate within the United Kingdom, subject to local regulatory requirements."</data>
  <data key="d2">chunk-6b5bfafb78d3fba9840d96ce7e8fc410&lt;SEP&gt;chunk-3679e0426d9ba539d7a46289e2bab63a&lt;SEP&gt;chunk-fb44d7769bde7d6f8440869a5a341430&lt;SEP&gt;chunk-d610724a0ad4c9bf19e1e6f7531d7eda</data>
