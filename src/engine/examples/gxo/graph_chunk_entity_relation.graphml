</edge>
<edge source="&quot;ACQUISITION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower may engage in Acquisition activities to enhance its business portfolio or market position."&lt;&lt;SEP&gt;"the Borrower plays a direct role in executing acquisitions as outlined in the terms of the credit agreement."</data>
  <data key="d6">"business strategy"&lt;SEP&gt;"transaction execution"</data>
  <data key="d7">chunk-a9ee4f98e9418b2314433f25ffaac06cca4e00777385e22ab35871fe9e0364f9&lt;SEP&gt;chunk-ebe5b7adcaae8d762224c153315aceccb8e517430bcc13042391071b592f8641</data>
