  <data key="d0">"REGULATORY"</data>
  <data key="d1">"Official orders issued by a legal authority, which have the force of law."</data>
  <data key="d2">chunk-c84f13ebb93a2379c4e024700e6b9a83</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;FUNDS&quot;">
  <data key="d0">"COLLATERAL"</data>
  <data key="d1">"Funds refer to the transferred amounts either as payments or loans that are subject to the terms of the Agreement."&lt;SEP&gt;"The monetary resources made available by the Lender to the Administrative Agent for disbursement to the Borrower."</data>
  <data key="d2">chunk-e30d6585214e77d70da4d2b41838c85a&lt;SEP&gt;chunk-ca6e59cb00ab074fd4164fff2fb0f72e</data>
