  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"A formal decision made by a court regarding the rights and liabilities of parties in a legal proceeding."&lt;SEP&gt;"Final determinations made by courts that can impact the interpretation of laws and regulations."&lt;SEP&gt;"References to any judgments against the borrower that may impact compliance with the credit agreement."</data>
  <data key="d2">chunk-c84f13ebb93a2379c4e024700e6b9a83&lt;SEP&gt;chunk-77ecd873e7a9d5e2ffb5d6892446a1df&lt;SEP&gt;chunk-9c6c404a605dbcd15dc33cc74d996977</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;DECISIONS&quot;">
