<node id="&quot;SECTION 10.01&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Specific subsection addressing delegation of duties related to the administration of the credit facility."&lt;SEP&gt;"This section designates the administrative agent's appointment and its corresponding authority."</data>
  <data key="d2">chunk-77ecd873e7a9d5e2ffb5d6892446a1df&lt;SEP&gt;chunk-7633d7a599488b163a331c3d926d3365</data>
