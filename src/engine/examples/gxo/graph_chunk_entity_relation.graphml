</edge>
<edge source="&quot;ACQUISITION&quot;" target="&quot;MATERIAL ACQUISITION&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"An Acquisition becomes a Material Acquisition if the total consideration meets or exceeds the specified threshold."</data>
