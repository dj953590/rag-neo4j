</edge>
<edge source="&quot;UK FINANCIAL INSTITUTION&quot;" target="&quot;PRA RULEBOOK&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The regulations defined in the PRA Rulebook directly affect the operations of UK Financial Institutions."</data>
  <data key="d6">"regulatory framework, compliance"</data>
