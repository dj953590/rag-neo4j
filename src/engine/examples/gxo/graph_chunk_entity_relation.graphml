  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;INTEREST PERIOD&quot;" target="&quot;BENCHMARK&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Interest Period duration is determined based on the applicable Benchmark value."&lt;</data>
  <data key="d6">"Determination, Reference"</data>
