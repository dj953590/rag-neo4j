  <data key="d2">chunk-b82ab4e4820c45842359419fd730cea8</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;ALTERNATE BASE RATE ADVANCE&quot;">
  <data key="d0">"FACILITY"</data>
  <data key="d1">"...the date such Advance is made or is converted from a Eurocurrency Advance into an Alternate Base Rate Advance..."&lt;SEP&gt;"A loan arrangement based on a specified interest rate, chosen by the Borrower for flexibility in repayment."&lt;SEP&gt;"A type of borrowing mechanism that can be converted into a Eurocurrency Advance as per the agreement's terms."&lt;SEP&gt;"A type of loan tied to an alternate base reference rate with interest payable in arrears."&lt;SEP&gt;"An Advance which bears interest at the Alternate Base Rate."&lt;SEP&gt;"An Alternate Base Rate Advance can be converted into a Eurocurrency Advance and bears interest based on the Alternate Base Rate."&lt;SEP&gt;"Another type of loan advance that the borrower may request, subject to minimum amounts."</data>
  <data key="d2">chunk-fb6e2d4916072445b0d7943e6df0abe4&lt;SEP&gt;chunk-3d35133a09e796f51c620fe44c317a1f&lt;SEP&gt;chunk-2bfa88e74387e9ded8d6d400ce29b863&lt;SEP&gt;chunk-303d4111dcc6924456507f281b537f2e&lt;SEP&gt;chunk-01fa9414c8f55fa15b04b2759525b64c&lt;SEP&gt;chunk-b237e569bb47a68fc1dfc5a53add55c1&lt;SEP&gt;chunk-c69c40f76d1bb8ba3d996a93ada3d2c7</data>
