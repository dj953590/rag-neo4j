<node id="&quot;REPRESENTATIONS AND WARRANTIES&quot;">
  <data key="d0">"COVENANTS"</data>
  <data key="d1">"Representations and Warranties are assurances made by the borrower regarding the accuracy of their claims related to the agreement."&lt;SEP&gt;"Representations and warranties are statements made by the Borrower that must be true and correct for the Request for Credit Extension to be honored."&lt;SEP&gt;"Statements made by parties to the agreement to assure the other parties of their qualifications and conditions."</data>
  <data key="d2">chunk-16bc6fb03d3fef88e01a6cce943dfcd4&lt;SEP&gt;chunk-a7fe64f66c3bae5bd7a455b76b08b5bc&lt;SEP&gt;chunk-99e694a36ce9e20cd42f9c5918c7a197</data>
