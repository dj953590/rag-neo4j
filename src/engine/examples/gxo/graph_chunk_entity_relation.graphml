</node>
<node id="&quot;PROTECTED PARTY&quot;">
  <data key="d0">"OBLIGOR"</data>
  <data key="d1">"Individuals or entities, including Administrative Agents and Lenders, that are protected from liability under the terms of the agreement."</data>
  <data key="d2">chunk-f189db920c3b77ea3f1a44e39b898e308875e6a8c5b0ae7b825de85e8b9d546f</data>
