  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;SPECIFIED INDEBTEDNESS FOR BORROWED MONEY&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrower is responsible for managing Specified Indebtedness for Borrowed Money, ensuring that it does not exceed allowable limits."</data>
  <data key="d6">"financial obligation"</data>
  <data key="d7">chunk-933342c9998e30f355fb1fd9ac245727f7b30b12ae83c53d533846bc90d0efb2</data>
  <data key="d8">DOC-236032ad52b5c77d76ca8b5b9d3ee21fa9d36f49e15211204ee2de8f5df0e70a</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;UK FINANCIAL INSTITUTION&quot;" target="&quot;U.S. PATRIOT ACT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The U.S. Patriot Act's regulations may apply to UK Financial Institutions operating in the U.S.""</data>
  <data key="d6">"regulatory compliance, jurisdiction"</data>
  <data key="d7">chunk-28eca6b21c8946b78c94ecada14fd9db0eacb6599496fdda1580ccb1cd064620</data>
