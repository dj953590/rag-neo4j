  <data key="d4">8.0</data>
  <data key="d5">"The Borrower is required to include a Statement of Operations along with financial statements to reflect its performance."|&gt;"financial performance"</data>
  <data key="d6">8</data>
  <data key="d7">chunk-4750653dea4761c7fb5326f7df76b1ff5616d96443298ddc9443f9ec1ed46068</data>
