  <data key="d0">"FACILITY"</data>
  <data key="d1">"A means of communication required for sending notices and other official documents among parties."&lt;SEP&gt;"A telecopier number is included for sending documents related to the credit agreement."&lt;SEP&gt;"The fax number provided for sending notices to the Borrower and Lenders."</data>
  <data key="d2">chunk-30985c7e8f8dee391f2bd509a43ea515&lt;SEP&gt;chunk-97ea2c276659bea1c507ce8061fac280&lt;SEP&gt;chunk-d984b41314faeae1eec3c3d4885dafca</data>
