<node id="&quot;GOLDMAN SACHS BANK USA&quot;">
  <data key="d0">"LENDER"</data>
  <data key="d1">"A financial institution identified as a lender in a credit agreement."&lt;SEP&gt;"Goldman Sachs Bank USA is a subsidiary of Goldman Sachs Group, providing investment banking and financial services, with a commitment of $65,000,000.00 in this credit agreement."</data>
  <data key="d2">chunk-00c71dd0104564827385ff8082a059de93da9189f0eabcb8930d7245af3fbdbe&lt;SEP&gt;chunk-a6b6ca2d4cc5d7f872dbe6f980264adf59bac19f237f2d2651238e50ce7188c0</data>
