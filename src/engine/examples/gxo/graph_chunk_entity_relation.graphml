  <data key="d0">"REGULATORY"</data>
  <data key="d1">"Legal notice pertaining to compliance with US regulations regarding ownership and verification in the context of lending activities."</data>
  <data key="d2">chunk-7633d7a599488b163a331c3d926d3365</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;OTHER CONNECTION TAXES&quot;">
  <data key="d0">"TAX-RELATED"</data>
  <data key="d1">"Taxes imposed as a result of connections between the Administrative Agent or Lender and the jurisdiction imposing such Tax."&lt;SEP&gt;"Taxes related to connections required under the agreement, critical for compliance with financial regulations."</data>
  <data key="d2">chunk-044c8c17addf705b3a705cce6b061dd6&lt;SEP&gt;chunk-45eacffe710b8a1539c2b0e28ec9c0b3</data>
