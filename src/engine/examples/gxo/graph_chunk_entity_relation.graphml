  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;COMMITMENT FEES&quot;" target="&quot;LENDER&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Lender charges Commitment Fees to the Borrower on any unused portion of the credit facility to compensate for reserving capital."</data>
  <data key="d6">"charge, compensate"</data>
