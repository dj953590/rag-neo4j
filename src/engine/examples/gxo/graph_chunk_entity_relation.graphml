  <data key="d0">"WAIVER"</data>
  <data key="d1">"The reallocation of obligations or use of cash to cover commitments related to letters of credit."&lt;SEP&gt;"The term refers to obligations that may be secured by cash collateral under certain conditions."</data>
  <data key="d2">chunk-e50dc3791859bd42e6b79be8ac39d58d&lt;SEP&gt;chunk-e631a64c88c6919f8b9a9bcae9c00286</data>
