</edge>
<edge source="&quot;GUARANTORS&quot;" target="&quot;LENDERS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Guarantors agree to back the Borrower's obligations, providing additional security to the Lenders in the event of default."&lt;</data>
  <data key="d6">"guarantee"</data>
  <data key="d7">chunk-1ce561170a0fb74a317902ec18937377457ffce5b30932924c9dcb1321a73c3a</data>
