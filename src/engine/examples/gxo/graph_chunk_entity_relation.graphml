</edge>
<edge source="&quot;L/C PARTICIPANT&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Administrative Agent coordinates notifications and payment demands between the Issuing Lender and L/C Participants."</data>
