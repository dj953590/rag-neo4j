  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LETTER OF CREDIT&quot;" target="&quot;LENDER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Lender issues a Letter of Credit to guarantee payment on behalf of the Borrower, ensuring financial obligations are met."</data>
  <data key="d6">"guaranteeing payment"</data>
  <data key="d7">chunk-b77f015c45a7573c444a9980fc7601fb5db09fa6ba499d28d02463542e445a50</data>
