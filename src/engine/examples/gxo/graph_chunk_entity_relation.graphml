  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PRICING LEVEL I&quot;" target="&quot;PUBLIC DEBT RATING&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Public Debt Rating of ≥ BBB+ and BBB establishes the criteria for Pricing Level I, influencing its margin and commitment fee."</data>
  <data key="d6">"conditional"</data>
  <data key="d7">chunk-81e0fb7f1c5c435e6c2b4165e987629875e6d2647fa4a981997538a14a894cdf</data>
