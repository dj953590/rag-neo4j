  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PBGC&quot;" target="&quot;BORROWED MONEY&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"PBGC is associated with the Permitted Refinancing of Specified Indebtedness for Borrowed Money, indicating its oversight role in relation to pension benefits."</data>
  <data key="d6">"oversight, pension financing"</data>
