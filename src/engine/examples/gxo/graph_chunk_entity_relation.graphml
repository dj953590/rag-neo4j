  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DECLINING LENDER&quot;" target="&quot;LENDER&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"A Declining Lender's refusal to consent can lead to complications for the Borrower regarding amendments to the Agreement."&lt;</data>
  <data key="d6">impact consent</data>
