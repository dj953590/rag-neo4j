  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The initial sum of money borrowed by the Borrower which is subject to interest payments over time."&lt;SEP&gt;"The principal amount refers to the initial sum of money that the Borrower is required to repay for the Indebtedness for Borrowed Money."</data>
  <data key="d2">chunk-2bfa88e74387e9ded8d6d400ce29b863&lt;SEP&gt;chunk-8682b6b632c76068654dbc45fa760d28</data>
