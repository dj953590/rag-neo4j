  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;SECTION 2.03&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"A specific provision within the agreement detailing the terms and conditions applicable to the issuance of Letters of Credit."&lt;SEP&gt;"A specific section within the agreement that outlines the responsibilities and timing for payments under the Letter of Credit."&lt;SEP&gt;"Provision that addresses the rights related to letter of credit commissions."&lt;SEP&gt;"Refers to a specific section of the agreement that outlines conditions relevant to the existing letter of credit."</data>
  <data key="d2">chunk-4a575e820a47b3c2dbd1089d67ed6dfe&lt;SEP&gt;chunk-45eacffe710b8a1539c2b0e28ec9c0b3&lt;SEP&gt;chunk-fc596f8efd3d960e41a0c7ead13fb1fe&lt;SEP&gt;chunk-6bfb84ae77fdaa5e8c3a97e04c2e26f6</data>
