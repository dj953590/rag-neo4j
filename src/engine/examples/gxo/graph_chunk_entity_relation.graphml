  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;INTEREST PERIOD&quot;" target="&quot;BENCHMARK REPLACEMENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The interest calculations are based on the duration specified in the Interest Period as part of the Benchmark Replacement."</data>
  <data key="d6">"based on, duration"</data>
