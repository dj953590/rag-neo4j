  <data key="d0">"FACILITY"</data>
  <data key="d1">"A specified duration for which a loan or financial arrangement is available."&lt;SEP&gt;"Available Tenor refers to the durations for which specific interest rates are applicable in the credit agreement."&lt;SEP&gt;"Available tenor refers to the duration of interest rates applicable to financial agreements, indicating the timeframe over which benchmarks are measured."</data>
  <data key="d2">chunk-98873f0978b82c2fd29714e88f71122d&lt;SEP&gt;chunk-21b7d377704d41cd539f04a2c3d2a312&lt;SEP&gt;chunk-455f5d24af85e0e01ce99360a0fe0f86</data>
