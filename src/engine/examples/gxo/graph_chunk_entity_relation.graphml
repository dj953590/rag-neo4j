  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PARTICIPANT&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Participant is allowed to receive benefits under the Agreement as if it were a Lender, thereby connecting its interest in the credit arrangement."&lt;</data>
  <data key="d6">"benefits"&lt;&lt;"6"</data>
  <data key="d7">chunk-b331bb28b5b328980bc6448e64c475bba021f2fd90308da50dd38ae5cdac4acd</data>
