  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CLOSING DATE&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Administrative Agent is responsible for managing the conditions to be met by the Closing Date in relation to the Credit Agreement."</data>
  <data key="d6">["management","contract terms"]</data>
