</edge>
<edge source="&quot;RELATED PARTIES&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Administrative Agent may act on behalf of Related Parties to ensure obligations are met under the Loan Document."</data>
