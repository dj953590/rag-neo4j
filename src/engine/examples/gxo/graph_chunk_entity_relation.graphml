  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LETTERS OF CREDIT&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Administrative Agent facilitates the process of issuing Letters of Credit and notifies relevant parties about the status of requests."}</data>
