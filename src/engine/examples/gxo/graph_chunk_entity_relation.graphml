</node>
<node id="&quot;LOAN PARTICIPATIONS&quot;">
  <data key="d0">"FACILITY"</data>
  <data key="d1">"The act of sharing in the loans provided under the credit agreement by multiple lenders, including the Defaulting Lender."</data>
  <data key="d2">chunk-e08590c6f860ab659cec13d7e2426aa7</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
