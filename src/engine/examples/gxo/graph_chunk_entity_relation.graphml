<node id="&quot;GUARANTORS&quot;">
  <data key="d0">"GUARANTOR"</data>
  <data key="d1">"Entities providing guarantees for obligations under the agreement, ensuring performance by the borrower and supporting the lenders' risk exposure."&lt;SEP&gt;"Subsidiaries of the Borrower that can become Guarantors upon meeting specific conditions."&lt;SEP&gt;"The Guarantors are entities that are parties to the Credit Agreement, responsible for guaranteeing the obligations of the Borrower."</data>
  <data key="d2">chunk-24419696c56548b55b76e26989b6a45a&lt;SEP&gt;chunk-7633d7a599488b163a331c3d926d3365&lt;SEP&gt;chunk-e631a64c88c6919f8b9a9bcae9c00286</data>
