</edge>
<edge source="&quot;EUROCURRENCY LOANS&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Administrative Agent manages the requests for Eurocurrency Loans, ensuring proper notifications and approvals are communicated to the Borrower and Lenders."}</data>
  <data key="d6">"management"</data>
  <data key="d7">chunk-59684afb2e463574cf2aaf600c780e0debe3a298245661d942ad591b5ac883c0</data>
