<node id="&quot;COMMITMENT FEE PAYMENT DATE&quot;">
  <data key="d0">"EXECUTED DATE"</data>
  <data key="d1">"Commitment Fee Payment Date specifies the defined date when the Borrower must make the Commitment Fee payment as outlined in the agreement."</data>
