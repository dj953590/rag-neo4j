  <data key="d2">chunk-928c9ed4796f36d4046ab5434f4288c0</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;90TH DAY&quot;">
  <data key="d0">"SCHEDULE"</data>
  <data key="d1">"The specific deadline for the Borrower to submit annual financial statements after each fiscal year."</data>
  <data key="d2">chunk-d7db23745e08dce95f931014f491b519</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
