<node id="&quot;COUNTERPARTS&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Counterparts are copies of the Agreement that may be executed by different parties, constituting a single contract."&lt;SEP&gt;"The Agreement may be executed in counterparts, each constituting an original."</data>
  <data key="d2">chunk-1c7fec4fdd82d22a739ed83a9be76e9c&lt;SEP&gt;chunk-d984b41314faeae1eec3c3d4885dafca</data>
