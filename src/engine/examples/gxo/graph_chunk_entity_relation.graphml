  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DECLINING LENDER&quot;" target="&quot;LENDERS&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Any Lender that does not agree to the extension request is categorized as a Declining Lender."&lt;</data>
  <data key="d6">decline</data>
  <data key="d7">chunk-020958809c614156af591a9b3b00a88a21bea48fbc904909f06d8dfd29243168</data>
