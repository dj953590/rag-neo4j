<edge source="&quot;CONSOLIDATED EBITDA&quot;" target="&quot;RATE MANAGEMENT TRANSACTIONS&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"the financial results from Rate Management Transactions are factored into the calculations of Consolidated EBITDA during the relevant periods."</data>
  <data key="d6">"financial metrics"</data>
