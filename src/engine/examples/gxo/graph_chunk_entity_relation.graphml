  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CONSOLIDATED LEVERAGE RATIO&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrower's financial leverage is assessed using the Consolidated Leverage Ratio based on its Indebtedness and EBITDA."</data>
  <data key="d6">"assessed by"</data>
