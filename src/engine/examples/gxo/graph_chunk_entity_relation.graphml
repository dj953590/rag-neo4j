<graph edgedefault="undirected"><node id="&quot;RATES APPLICABLE AFTER DEFAULT&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Specifies the interest rates that will apply in the event of default by the borrower."</data>
  <data key="d2">chunk-285be243c5ad90acd795b6efd3e10813f6b0fc81e87f36039e9517d2db3b1860</data>
