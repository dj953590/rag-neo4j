<node id="&quot;COMMITMENT REDUCTIONS&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The process by which the overall committed amount to provide loan facilities is decreased based on the borrower’s needs or lender's decisions."</data>
  <data key="d2">chunk-e30d6585214e77d70da4d2b41838c85a</data>
