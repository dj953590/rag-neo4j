  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CERTIFICATE OF ISSUING LENDER&quot;" target="&quot;ISSUING LENDER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Issuing Lender issues a Certificate to confirm any amounts owed or payments required under the credit agreement, facilitating clarity on obligations."</data>
  <data key="d6">"confirmation, obligation"</data>
