  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;GUARANTOR&quot;" target="&quot;SECTION 16.04&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"Section 16.04 describes the waivers applicable to the Guarantor's obligations."&lt;</data>
  <data key="d6">"describes"</data>
  <data key="d7">chunk-f9486f855a0c60e068fa1888069132035c2411f88304d639f451422296a3520c</data>
  <data key="d8">DOC-236032ad52b5c77d76ca8b5b9d3ee21fa9d36f49e15211204ee2de8f5df0e70a</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;GUARANTOR&quot;" target="&quot;LIABILITY&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Guarantor's liability is absolute and unconditional with respect to the obligations outlined in the Guarantee."&lt;</data>
  <data key="d6">"absolute liability"</data>
  <data key="d7">chunk-f9486f855a0c60e068fa1888069132035c2411f88304d639f451422296a3520c</data>
  <data key="d8">DOC-236032ad52b5c77d76ca8b5b9d3ee21fa9d36f49e15211204ee2de8f5df0e70a</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;GUARANTOR&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Guarantee is a continuing agreement between the Guarantor and the other entities that secures the Borrower's obligations."&lt;</data>
  <data key="d6">Secured Guarantee&lt;</data>
  <data key="d7">chunk-dfae90ac75934f3a0aa495e4b1945f7c157fd6f848b6ca39885db21029c243e9</data>
