</node>
<node id="&quot;EUROCURRENCY LIABILITIES&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"Obligations related to borrowings that are linked to foreign monetary systems, which are subject to specific reserve requirements under regulatory policies."</data>
  <data key="d2">chunk-c949aa98795a964a83fee0d2a5cf1003c8a3dcd6bd2a627dc984864d17e0a5d2</data>
