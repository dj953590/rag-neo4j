  <data key="d0">"INTEREST RATE"</data>
  <data key="d1">"The interest rate applied to the erroneous payments based on prevailing market rules for interbank compensation and the Federal Funds Rate."</data>
  <data key="d2">chunk-2312b6c1d8ad4b95ad6661f4fa1b286f</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
