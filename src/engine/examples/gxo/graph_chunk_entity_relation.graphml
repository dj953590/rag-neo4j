  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;LONDON INTERBANK MARKET&quot;">
  <data key="d0">"MARKET"</data>
  <data key="d1">"A market where currencies are traded between banks and financial institutions, particularly relevant for converting currencies to Dollars."&lt;SEP&gt;"The London interbank market is relevant for determining the basis of accrual of interest for loans denominated in currencies such as the Euro."</data>
  <data key="d2">chunk-4f1be3cca81841828b69a682f741856e&lt;SEP&gt;chunk-da627f496ed5b278745386e332bef7e2</data>
