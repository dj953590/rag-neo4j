  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CLOSING DATE&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Closing Date marks the completion of the Agreement's preconditions and the initiation of the loan disbursement process."</data>
  <data key="d6">"completion, initiation"</data>
