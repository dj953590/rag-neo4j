  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"A fee the Borrower must pay to the Administrative Agent when requiring an assignment of the Lender's interests."</data>
  <data key="d2">chunk-13482f9d41736bece8f6cc18418a9fba</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
