<node id="&quot;MATERIAL NON-PUBLIC INFORMATION&quot;">
  <data key="d0">"INFORMATION"</data>
  <data key="d1">"Material Non-Public Information refers to sensitive data received from the Borrower that is not available to the public and must be handled according to legal regulations."</data>
