  <data key="d4">1.0</data>
  <data key="d5">"The Payment Recipient is required to interact with the Lender regarding payments received, particularly in the event of errors or discrepancies."&lt;</data>
  <data key="d6">"Payment Interaction"&lt;</data>
  <data key="d7">chunk-9d98031430f0b0255f48182995737acdd3844c6fd9557981e0e3bf24bdd46f8d</data>
  <data key="d8">DOC-236032ad52b5c77d76ca8b5b9d3ee21fa9d36f49e15211204ee2de8f5df0e70a</data>
