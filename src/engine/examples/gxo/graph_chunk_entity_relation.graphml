</node>
<node id="&quot;AFFECTED FINANCIAL INSTITUTION&quot;">
  <data key="d0">"COMPANY"</data>
  <data key="d1">"An institution that may be subject to regulatory actions including Write-Down and Conversion Powers outlined in the agreement."</data>
  <data key="d2">chunk-030278384b922b4dde4eb789cb2a8bc568f20779afcf9493b74bd661c5c80d27</data>
