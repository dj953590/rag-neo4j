</edge>
<edge source="&quot;PAYMENT&quot;" target="&quot;TRUST&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Payment is required to be returned under the legal obligations outlined in the Trust established for the benefit of the Administrative Agent.</data>
  <data key="d6">["obligation", "return"]</data>
  <data key="d7">chunk-337171a55b9c980d0dcb5ffb1bd97f2bfe3343740427c244b5a793ad0cef374b</data>
