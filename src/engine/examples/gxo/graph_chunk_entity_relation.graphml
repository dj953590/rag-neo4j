<node id="&quot;AGREEMENT CURRENCY&quot;">
  <data key="d0">"CURRENCY"</data>
  <data key="d1">"Defined in Section 15.06 referencing the currency used in the agreement."&lt;SEP&gt;"The Agreement Currency is the currency in which sums due under the Agreement are denominated."&lt;SEP&gt;"The currency in which the sum is denominated according to the provisions laid out in the Agreement."&lt;SEP&gt;"The specific currency in which the Credit Agreement operates, defined in Section 15.06 of the document."</data>
  <data key="d2">chunk-d88c08aa03f546119db2aa5503fb5d3b&lt;SEP&gt;chunk-303d4111dcc6924456507f281b537f2e&lt;SEP&gt;chunk-4792b5b0b77bf53c196055d4d402e155&lt;SEP&gt;chunk-7b3c1b09c7a3b24aa925d3f14133dc8f</data>
