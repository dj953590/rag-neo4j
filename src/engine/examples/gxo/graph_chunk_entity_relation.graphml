  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;BACKUP WITHHOLDING TAX&quot;">
  <data key="d0">"TAX-RELATED"</data>
  <data key="d1">"A specific type of tax that must be withheld from payments to a Lender if certain compliance conditions aren't met."</data>
  <data key="d2">chunk-45eacffe710b8a1539c2b0e28ec9c0b3</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
