  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PBGC&quot;" target="&quot;REPORTABLE EVENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The PBGC has specific requirements regarding the notification of Reportable Events under ERISA."</data>
  <data key="d6">"regulatory requirement"</data>
