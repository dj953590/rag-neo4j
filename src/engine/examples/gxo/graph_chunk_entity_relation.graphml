</edge>
<edge source="&quot;RELATED PARTIES&quot;" target="&quot;SECTION 9.05&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"This section indicates that Related Parties do not acquire any rights unless expressly mentioned in the agreement."&lt;</data>
