  <data key="d4">6.0</data>
  <data key="d5">"The Borrower authorizes the Lender to disclose information regarding creditworthiness to the Participant."</data>
  <data key="d6">"information dissemination"</data>
  <data key="d7">chunk-bd902267cf6f0db3be25c1294151e19a0be784f5b9abcd4f5dd33a2f1be9deab</data>
