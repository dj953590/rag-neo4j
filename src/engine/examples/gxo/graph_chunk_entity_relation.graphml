  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;RATE MANAGEMENT TRANSACTION&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Administrative Agent oversees the execution of Rate Management Transactions as part of financial management under the credit agreement."</data>
