  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;OBLIGATION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower must fulfill various Obligations under the credit agreement, including repayment of the Loan and compliance with covenants."</data>
  <data key="d6">"fulfilling duties"</data>
