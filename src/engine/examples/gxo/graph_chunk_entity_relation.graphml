  <data key="d3">DOC-236032ad52b5c77d76ca8b5b9d3ee21fa9d36f49e15211204ee2de8f5df0e70a</data>
</node>
<node id="&quot;EU BAIL-IN LEGISLATION SCHEDULE&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"EU Bail-In Legislation Schedule means the EU Bail-In Legislation Schedule published by the Loan Market Association (or any successor person), as in effect from time to time."</data>
