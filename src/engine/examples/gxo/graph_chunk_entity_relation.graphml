</edge>
<edge source="&quot;BENCHMARK&quot;" target="&quot;AVAILABLE TENOR&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Available Tenor may be defined as any tenor within the applicable Benchmark's structure for interest calculations."&lt;</data>
  <data key="d6">"Definition, Structure"</data>
