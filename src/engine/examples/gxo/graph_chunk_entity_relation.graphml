  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;CONSENT REQUIRED&quot;">
  <data key="d0">"COVENANTS"</data>
  <data key="d1">"Consent Required refers to the permissions needed from various parties for assignments, especially involving the borrower and administrative agent."</data>
  <data key="d2">chunk-f7ba5dd3dff3a1a68f89de13b8aa21f2</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
