  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;PARTICIPATIONS&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"Participations in this context refer to the distribution or sharing of financial responsibility among lenders related to the Loans made."&lt;SEP&gt;"a Lender shall... purchase (for cash at face value) participations in the Loans of the other Lenders."</data>
  <data key="d2">chunk-7dde35fec0c8bee31e9959cd10aeb752&lt;SEP&gt;chunk-52bf93d3e20b62a0cd832df66353f563</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
