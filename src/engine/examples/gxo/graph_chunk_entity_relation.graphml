<edge source="&quot;PUBLIC DEBT RATING&quot;" target="&quot;FITCH&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"Fitch establishes Public Debt Ratings that are referenced for determining financial conditions in agreements."&lt;</data>
  <data key="d6">"rating provider"</data>
