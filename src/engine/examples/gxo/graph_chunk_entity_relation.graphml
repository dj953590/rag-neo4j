<node id="&quot;RESERVE REQUIREMENT&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The total aggregate reserve that is mandated under Regulation D for Eurocurrency liabilities, affecting the effective cost of borrowing."</data>
  <data key="d2">chunk-c949aa98795a964a83fee0d2a5cf1003c8a3dcd6bd2a627dc984864d17e0a5d2</data>
