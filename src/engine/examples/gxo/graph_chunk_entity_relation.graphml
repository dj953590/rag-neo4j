<node id="&quot;ACTUAL UNUSED COMMITMENTS&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The daily actual excess of each Lender's Commitment over its Outstanding Credit Exposure, calculated for the purposes of the Commitment Fee."&lt;SEP&gt;"defined in Section 2.05(a), referring to the portion of commitments that have not been utilized."</data>
  <data key="d2">chunk-7e55ec0667ebf49101d269a842009d25&lt;SEP&gt;chunk-fb44d7769bde7d6f8440869a5a341430</data>
