  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;EUROCURRENCY LOANS&quot;" target="&quot;LENDER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Lender offers Eurocurrency Loans to the Borrower based on market conditions and interest rates as part of the credit facility."&lt;</data>
  <data key="d6">relationship_keywords&lt;</data>
