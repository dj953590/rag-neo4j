<edge source="&quot;CONSOLIDATED BALANCE SHEET&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrower must provide a Consolidated Balance Sheet as part of the financial reporting requirements to its lenders."|&gt;"financial reporting"</data>
  <data key="d6">8</data>
  <data key="d7">chunk-4750653dea4761c7fb5326f7df76b1ff5616d96443298ddc9443f9ec1ed46068</data>
