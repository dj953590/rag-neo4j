  <data key="d4">1.0</data>
  <data key="d5">"The Administrative Agent oversees the maintenance and accuracy of the Participant Register, ensuring that all interest holdings of Participants are correctly recorded."&lt;</data>
  <data key="d6">"management"&lt;&lt;"8"</data>
