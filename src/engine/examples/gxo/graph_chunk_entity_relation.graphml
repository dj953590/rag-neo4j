  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;TIME OF REPLACEMENT&quot;">
  <data key="d0">"EXECUTED DATE"</data>
  <data key="d1">"Time of Replacement refers to the moment when the initial benchmark rate is officially substituted by a Benchmark Replacement."</data>
  <data key="d2">chunk-98873f0978b82c2fd29714e88f71122d</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;REQUISITE AMOUNT&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"A specified large monetary amount, set as $100,000,000 in the agreement."&lt;SEP&gt;"The minimum amount that triggers specific obligations for the Borrower in relation to judgments or orders."&lt;SEP&gt;"The requisite amount is the minimum level of debt that can trigger default provisions under the Agreement."</data>
