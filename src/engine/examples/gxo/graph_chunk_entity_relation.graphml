</edge>
<edge source="&quot;INTEREST PERIOD&quot;" target="&quot;LENDER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Interest is calculated based on defined Interest Periods according to the agreement between the Borrower and Lender."</data>
  <data key="d6">"interest calculation"</data>
  <data key="d7">chunk-c2e76bfe06832d96f514332019f438cc910c77413f0617abc31b13b1ced12faa</data>
