  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CLOSING DATE&quot;" target="&quot;LOAN&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Closing Date is when the Loan transaction is officially completed and the Borrower receives funds."</data>
  <data key="d6">"transaction completion"</data>
  <data key="d7">chunk-5ce8a112ad9bc4f178c0e7682716633ad80585fa573f2db52e4399573e429b10</data>
