<edge source="&quot;DEFAULT&quot;" target="&quot;LENDER&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Lender's rights are impacted by a Default condition, activating specific actions and rights such as setoff against the Borrower for outstanding Obligations."}</data>
  <data key="d6">8</data>
  <data key="d7">chunk-3a5b1ddd76b46da4f5b285127348b0ac9622761aad50db0119a29e624efdf1ee</data>
