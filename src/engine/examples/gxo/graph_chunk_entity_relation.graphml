  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;WAIVER&quot;">
  <data key="d0">"WAIVER"</data>
  <data key="d1">"A Waiver refers to the voluntary relinquishment of a contractual right or obligation under the terms of the Agreement."&lt;SEP&gt;"A legal decision by the Lender to forgo enforcement of certain provisions within the Agreement."&lt;SEP&gt;"A waiver is required for any amendment or modification depending on the consent of the Defaulting Lender."&lt;SEP&gt;"in the case of any such assignment resulting from a failure to consent to an amendment or waiver approved by the Required Lenders."</data>
  <data key="d2">chunk-7dde35fec0c8bee31e9959cd10aeb752&lt;SEP&gt;chunk-83c42000811c18c4fe1fb14e6839c213&lt;SEP&gt;chunk-ef03c2a3bc83b467c592d30c98456018&lt;SEP&gt;chunk-6b81ad32680319d4fa9bb79e2517486d</data>
