</edge>
<edge source="&quot;BENEFIT PLAN&quot;" target="&quot;ERISA&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Benefit Plan must comply with the regulations set forth by ERISA."&lt;</data>
  <data key="d6">"Compliance, Regulations"</data>
  <data key="d7">chunk-30dfd32b0cc9b04004fb69c1cd353fb396870e7d97974f09ab4577578d08dfbd</data>
