  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Document delivery involves the process by which the Borrower submits necessary documents to the Administrative Agent as required by the agreement."&lt;SEP&gt;"The obligation of the Borrower to furnish certain documents and reports under the terms of the agreement."</data>
  <data key="d2">chunk-6486173d4e89e0b5a1e51ec7b8969261&lt;SEP&gt;chunk-99e694a36ce9e20cd42f9c5918c7a197</data>
