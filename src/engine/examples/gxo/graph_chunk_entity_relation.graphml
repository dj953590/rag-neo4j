<node id="&quot;ELIGIBLE ASSIGNEE&quot;">
  <data key="d0">"ASSIGNEE"</data>
  <data key="d1">"An Eligible Assignee can be a recipient of loan assignments under specific conditions defined in the Agreement."&lt;SEP&gt;"An Eligible Assignee is an entity that can be assigned rights and responsibilities under the agreement."&lt;SEP&gt;"An Eligible Assignee refers to a legal entity or person eligible to receive rights and obligations under the agreement."&lt;SEP&gt;"Any entity that can be assigned rights and obligations from a Declining Lender under specified conditions."&lt;SEP&gt;"Any person who meets the requirements to be assigned rights under the agreement, subject to specified consents."&lt;SEP&gt;"a party eligible to receive loan rights through assignment under the agreement."</data>
  <data key="d2">chunk-a7fe64f66c3bae5bd7a455b76b08b5bc&lt;SEP&gt;chunk-d78df53bf404a8c04f30aed8e096f054&lt;SEP&gt;chunk-d78a94bb2c8dc099ee3742dd06619dd7&lt;SEP&gt;chunk-e6e6633392fc0a2358006ce0dd843d1a&lt;SEP&gt;chunk-f7ba5dd3dff3a1a68f89de13b8aa21f2&lt;SEP&gt;chunk-50d92f3ae85f5d9dc7cd636aa2549b31</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
