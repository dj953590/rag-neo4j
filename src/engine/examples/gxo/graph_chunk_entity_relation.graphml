</node>
<node id="&quot;DEUTSCHE BANK AG NEW YORK BRANCH&quot;">
  <data key="d0">"LENDER"</data>
  <data key="d1">"DEUTSCHE BANK AG NEW YORK BRANCH, as a Lender."&lt;SEP&gt;"Deutsche Bank AG New York Branch is a branch of the global banking company, providing various financial services, with a commitment of $65,000,000.00 in this credit agreement."</data>
  <data key="d2">chunk-b1dfcf35c71b9bc1649a0165fc3f3382c476139fd8e243735127e10bcebe9770&lt;SEP&gt;chunk-00c71dd0104564827385ff8082a059de93da9189f0eabcb8930d7245af3fbdbe</data>
