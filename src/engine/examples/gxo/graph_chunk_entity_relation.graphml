</edge>
<edge source="&quot;SECTION 16.06&quot;" target="&quot;AUTHORIZED OFFICER&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Authorized Officer must ensure that the requirements outlined in Section 16.06 are fulfilled, linking them directly to the compliance process."&lt;</data>
  <data key="d6">ensure, compliance</data>
