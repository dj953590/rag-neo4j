  <data key="d0">"AMENDMENT"</data>
  <data key="d1">"A formal communication sent by the Administrative Agent detailing the specifics of payments, which must accompany any financial transactions."</data>
  <data key="d2">chunk-2312b6c1d8ad4b95ad6661f4fa1b286f</data>
  <data key="d3">DOC-0a132332ec994ff64af411572927a941</data>
  <data key="d4">citibank-gxo</data>
</node>
<node id="&quot;PARTNERSHIP INTERESTS&quot;">
  <data key="d0">"SECURITY"</data>
  <data key="d1">"Describes ownership stakes in partnerships, also considered in the context of the Borrower's acquisitions."</data>
