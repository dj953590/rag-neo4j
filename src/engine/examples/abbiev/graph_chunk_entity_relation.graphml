<node id="&quot;PRINCIPAL DOMESTIC PROPERTY&quot;">
  <data key="d0">"FINANCIAL"</data>
  <data key="d1">"Key assets owned by the Borrower or Domestic Subsidiary that may be secured against loans."&lt;SEP&gt;"Refers to any building, structure, or facility used primarily for manufacturing or distribution, which is owned or leased by any member of the Consolidated Group and meets certain value thresholds."&lt;SEP&gt;"Refers to significant assets owned by the Domestic Subsidiary, which can affect credit risk assessments and obligations under the agreement."</data>
  <data key="d2">chunk-be2493d0103919c27e88c4d44795e6271de20e61d113f608a0e09b6a8035e77e&lt;SEP&gt;chunk-2532dceb11310f90fe874dcb7a03665b47bca038a4f5360f466bf9fb8d95bca4&lt;SEP&gt;chunk-6f1c734d846f35a655ca01c490cae44d5b50d73762de164b96169839717dc150</data>
