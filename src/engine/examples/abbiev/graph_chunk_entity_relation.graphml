<node id="&quot;FEDERAL DEPOSIT INSURANCE CORPORATION&quot;">
  <data key="d0">"REGULATORY"</data>
  <data key="d1">"A U.S. government agency that protects depositors by providing insurance on deposits in banks, which can influence credit agreements indirectly through regulatory measures."</data>
