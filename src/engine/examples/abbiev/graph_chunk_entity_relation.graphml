  <data key="d4">8.0</data>
  <data key="d5">"Both exhibits are part of the legal documentation for the credit agreement."}</data>
  <data key="d6">["legal", "documentation", "credit agreement"]</data>
  <data key="d7">chunk-fc2bd6d38a427261506e79c61e760df7064ed466412b69e938b252fe5e96bd95</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;RELEVANT GOVERNMENTAL BODY&quot;" target="&quot;SPREAD ADJUSTMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Relevant Governmental Body proposes the spread adjustment necessary for transitioning from LIBOR to a new benchmark rate."</data>
  <data key="d6">recommendation, adjustment</data>
  <data key="d7">chunk-78362831995eec40b3305bc8a7d598334904e9a3e5e4037fec3ad342ec088a9a</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LIEN&quot;" target="&quot;BORROWED DEBT&quot;">
  <data key="d4">10.0</data>
  <data key="d5">"The secured Borrowed Debt may result in a legal claim on the Borrower's assets if they default."</data>
  <data key="d6">"Security Interests"</data>
  <data key="d7">chunk-6f1c734d846f35a655ca01c490cae44d5b50d73762de164b96169839717dc150</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LIEN&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower is subject to a Lien placed on assets to secure loans, ensuring the lender has a claim if obligations are not met."</data>
  <data key="d6">"security, obligation"</data>
  <data key="d7">chunk-9596d6913071768b731e90c3fce70fd8e8b7dce447b1bd785f16af66c5018e80</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;ANNUAL REPORT ON FORM 10-K&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower must disclose its financial position in the Annual Report on Form 10-K, a critical document for assessing compliance under the credit agreement."</data>
  <data key="d6">"reporting relationship"</data>
  <data key="d7">chunk-dab0531fa4fcf86f70f5a6e071aafc6b5ff5db2eaa35dfe862105382145767e3</data>
