<node id="&quot;CONSOLIDATED GROUP OFFICERS&quot;">
  <data key="d0">"OBLIGOR"</data>
  <data key="d1">"The officers and directors of the Consolidated Group who are responsible for ensuring compliance with the various laws applicable to the Borrower."</data>
