</node>
<node id="&quot;APPLICABLE CREDITOR&quot;">
  <data key="d0">"OBLIGOR"</data>
  <data key="d1">"The Applicable Creditor refers to any party or entity receiving payments under the agreement, maintaining a significant role in collection and transaction of owed sums."</data>
  <data key="d2">chunk-245f24acd98603313a2446a8d5a32f7a192d4383d71b7f423ff6fdab962825e4</data>
