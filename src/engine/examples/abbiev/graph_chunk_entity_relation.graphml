  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;MATURITY DATE&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">10.0</data>
  <data key="d5">"The loan must be fully repaid by the maturity date, marking the end of the borrowing period."</data>
  <data key="d6">"financial timeline"</data>
  <data key="d7">chunk-7af28d15bebf0aa3c3c5d3e5c5b05093f378e5f6d86107e87b93c7d9adb5bca5</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;OTHER TAXES&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">17.0</data>
  <data key="d5">"The Borrower agrees to pay any Other Taxes related to payments under the Loan Document."&lt;SEP&gt;"The borrower is responsible for any other taxes applicable to them under the terms of the loan agreement."</data>
  <data key="d6">"pays taxes, obligation"&lt;SEP&gt;"responsible for"</data>
  <data key="d7">chunk-557ca50e2e7ed07027fe1bc3a3d46b4aca0b92a15a8793019d9d077f72596b84&lt;SEP&gt;chunk-be7bce265f7668641305b669fcfae3cec84ce21e98d4c457d96cadd73dddfbf0</data>
