<node id="&quot;JPMORGAN CHASE BANK, N.A.&quot;">
  <data key="d0">"LENDER"</data>
  <data key="d1">"A financial institution serving as the administrative agent in the Existing Credit Agreement, providing financing and ensuring compliance."&lt;SEP&gt;"A financial institution that acts as a lender in the Revolving Credit and Guaranty Agreement involving Allergan and its subsidiaries."</data>
  <data key="d2">chunk-59856153649b40596d478b3e3da65ad43c5f06c034b24225cd62242ce120ef82&lt;SEP&gt;chunk-be2493d0103919c27e88c4d44795e6271de20e61d113f608a0e09b6a8035e77e</data>
