  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DOCUMENTATION AGENT&quot;" target="&quot;LENDER&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Documentation Agent coordinates the necessary documentation involving the Lenders within the credit agreement."&lt;</data>
  <data key="d6">7</data>
  <data key="d7">chunk-2532dceb11310f90fe874dcb7a03665b47bca038a4f5360f466bf9fb8d95bca4</data>
