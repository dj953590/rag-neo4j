  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;MATURITY DATE&quot;" target="&quot;INTEREST PERIOD&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"Interest Period must be selected in relation to the Maturity Date to ensure compliance with payment timelines."</data>
  <data key="d6">"Timeline Compliance"</data>
  <data key="d7">chunk-f67a33f5df6562c3788421c933dfc2f1287e8f4e4596bbd09e2b3a2f360ddf57</data>
