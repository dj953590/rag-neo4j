<node id="&quot;ELIGIBLE ASSIGNEE&quot;">
  <data key="d0">"ASSIGNEE"</data>
  <data key="d1">"An assignee that meets specific criteria to receive rights or obligations under the credit agreement through a transfer from the original party."&lt;SEP&gt;"any Person that becomes an assignee pursuant to Section 9.07(a), which includes specific conditions for qualification."</data>
