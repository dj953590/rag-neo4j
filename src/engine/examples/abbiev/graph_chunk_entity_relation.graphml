  <data key="d4">7.0</data>
  <data key="d5">"These forms are part of the documentation required for executing a credit agreement."}</data>
  <data key="d6">["documentation", "part of", "credit agreement"]</data>
  <data key="d7">chunk-fc2bd6d38a427261506e79c61e760df7064ed466412b69e938b252fe5e96bd95</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BENCHMARK REPLACEMENT DATE&quot;" target="&quot;BENCHMARK TRANSITION EVENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Benchmark Replacement Date is triggered by a Benchmark Transition Event, indicating when the transition from LIBOR takes effect."</data>
  <data key="d6">trigger, transition</data>
  <data key="d7">chunk-78362831995eec40b3305bc8a7d598334904e9a3e5e4037fec3ad342ec088a9a</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULT INTEREST&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">11.0</data>
  <data key="d5">"If the Borrower defaults on payments, the Default Interest is applied as a penalty per the terms of the agreement."&lt;SEP&gt;"If the Borrower defaults, they will be subject to Default Interest as a penalty."&lt;SEP&gt;"The Borrower is mandated to pay Default Interest upon defaulting on any payments."</data>
  <data key="d6">"payment obligation"&lt;SEP&gt;"penalty"&lt;SEP&gt;"penalty, obligation"</data>
  <data key="d7">chunk-218e43d49365393bf48168169286d22a5df7ee1b88b398c5561de8f95be5878f&lt;SEP&gt;chunk-d7e324da9ca1b1564ebc9a89d11b7e3f3471a27e48cdcb34c0c7216ce61d335f&lt;SEP&gt;chunk-b51600eae536cd47259633337cdac9c729e6dcdfe218308793a634df08bf67a7</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;EUROCURRENCY RATE ADVANCES&quot;" target="&quot;LENDER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Lender provides Eurocurrency Rate Advances to the Borrower under specified conditions laid out in the agreement."</data>
  <data key="d6">"loan"</data>
  <data key="d7">chunk-6fc4d08c3313588875690a6e3517754dd273e5008229a9650ffc8862e6d0c261</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;EUROCURRENCY RATE ADVANCES&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">10.0</data>
  <data key="d5">"The Borrower receives Eurocurrency Rate Advances that require interest rates to be fulfilled."&lt;SEP&gt;"The borrower is obligated to pay interest on Eurocurrency rate advances, in accordance with the terms outlined in the agreement."</data>
  <data key="d6">"financial terms"&lt;SEP&gt;"loan type"</data>
  <data key="d7">chunk-7af28d15bebf0aa3c3c5d3e5c5b05093f378e5f6d86107e87b93c7d9adb5bca5&lt;SEP&gt;chunk-d7e324da9ca1b1564ebc9a89d11b7e3f3471a27e48cdcb34c0c7216ce61d335f</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;EUROCURRENCY RATE ADVANCES&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Administrative Agent determines and manages the Eurocurrency Rate for Advances given to the Borrower."</data>
  <data key="d6">"rate management"</data>
  <data key="d7">chunk-d7e324da9ca1b1564ebc9a89d11b7e3f3471a27e48cdcb34c0c7216ce61d335f</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CONSOLIDATED SUBSIDIARIES&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Borrower's obligations extend to its Consolidated Subsidiaries, which contribute to the overall financial health assessed under the credit agreement."</data>
  <data key="d6">"corporate structure relationship"</data>
  <data key="d7">chunk-dab0531fa4fcf86f70f5a6e071aafc6b5ff5db2eaa35dfe862105382145767e3</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;PARTICIPATION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Participation arrangement enables the Borrower to engage with multiple Lenders for financing, expanding the sources of capital available for repayment."</data>
  <data key="d6">"collaboration, financing"</data>
  <data key="d7">chunk-c14dc72f1acf50414a477c2db2c796ddbbd61a6a79ce8e689f589c7f4fe13c8f</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;GENERAL PROVISIONS&quot;" target="&quot;ASSIGNMENT AND ASSUMPTION&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Assignment and Assumption includes General Provisions that govern its execution and enforceability."</data>
  <data key="d6">"governance, enforceability"</data>
  <data key="d7">chunk-f017c94dcbd47e1b84a1e23aa6ce599d075b32b712dd01a176cb8ce4431a2a80</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;ASSIGNMENT AND ASSUMPTION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Borrower may require a Defaulting Lender to execute an Assignment and Assumption to transfer its rights."</data>
  <data key="d6">"transfer of rights"</data>
  <data key="d7">chunk-7e5101875bbe6af73647ed36abe0f23011cd57aa7a0b2cfc76e2acb7141d4d3d</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;ASSIGNMENT AND ASSUMPTION&quot;" target="&quot;LENDER&quot;">
  <data key="d4">15.0</data>
  <data key="d5">"Assignment and Assumption involves a Lender entering into a contract with an Eligible Assignee to transfer their rights and obligations under the agreement."&lt;SEP&gt;"The Lender participates in executing the Assignment and Assumption as a part of the assignment process, confirming the transfer of rights and obligations."</data>
  <data key="d6">"contractual transfer"&lt;SEP&gt;engagement</data>
  <data key="d7">chunk-42655ae5c10ca5a5455649629ca19df62fdf6ee510c4c866b8072d6acd3b5aaf&lt;SEP&gt;chunk-7c38a12ba82433270b2fc4359bfa48fd2baab5dad2c61ceb1e29ec15a6475843</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;ASSIGNMENT AND ASSUMPTION&quot;" target="&quot;EFFECTIVE DATE&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Effective Date marks the commencement of the contractual obligations outlined in the Assignment and Assumption."</data>
  <data key="d6">"governance, execution"</data>
  <data key="d7">chunk-f017c94dcbd47e1b84a1e23aa6ce599d075b32b712dd01a176cb8ce4431a2a80</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;ASSIGNMENT AND ASSUMPTION&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">15.0</data>
  <data key="d5">"The Administrative Agent is responsible for accepting and recording the Assignment and Assumption as per the procedural requirements mentioned in the Agreement."&lt;SEP&gt;"The Administrative Agent is responsible for recording information regarding Assignment and Assumption in the Register as per the agreement."</data>
  <data key="d6">"record management"&lt;SEP&gt;administrative oversight</data>
  <data key="d7">chunk-45f48aac073454f64321c0cdc25d2c032423f2d9bb3784ae8f741bfbe60eb624&lt;SEP&gt;chunk-7c38a12ba82433270b2fc4359bfa48fd2baab5dad2c61ceb1e29ec15a6475843</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BENCHMARK TRANSITION EVENT&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Administrative Agent must facilitate the amendment process triggered by a Benchmark Transition Event, ensuring that all parties are informed and compliant."</data>
  <data key="d6">7</data>
  <data key="d7">chunk-866fe4ac1b993c84e8ec6b0b6c75c0299a953c019bffdef5132359bb147793f1</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULTING LENDER&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">14.0</data>
  <data key="d5">"A Defaulting Lender is automatically removed from the role of Administrative Agent, impacting the administration of the loan agreement."&lt;SEP&gt;"A Defaulting Lender must notify the Administrative Agent and the Borrower about its failure to fund."&lt;SEP&gt;"The Administrative Agent manages the processes involving Defaulting Lenders, particularly in cases where they fail to meet obligations under the credit agreement."</data>
  <data key="d6">"notification"&lt;SEP&gt;"removal, impacts"&lt;SEP&gt;4</data>
  <data key="d7">chunk-218e43d49365393bf48168169286d22a5df7ee1b88b398c5561de8f95be5878f&lt;SEP&gt;chunk-866fe4ac1b993c84e8ec6b0b6c75c0299a953c019bffdef5132359bb147793f1&lt;SEP&gt;chunk-5c5be4b86bb874c0ebcd5df3142d803b7aef8e7c1c715535d330936fe5a0dce9</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULTING LENDER&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">21.0</data>
  <data key="d5">"In instances where a Defaulting Lender fails to meet its funding obligations, the Borrower may need to address the resulting financial implications under the agreement."&lt;SEP&gt;"The Borrower may have to deal with a Defaulting Lender's situation by reassigning its interests under the Agreement."&lt;SEP&gt;"The Defaulting Lender has funding obligations that, if unmet, impact the Borrower's access to financial resources."&lt;SEP&gt;"The borrower may face consequences or provisions specifically related to any lender that defaults on their obligations."</data>
  <data key="d6">"contractual relationship"&lt;SEP&gt;"impact"&lt;SEP&gt;"reassignment"&lt;SEP&gt;6</data>
  <data key="d7">chunk-7af28d15bebf0aa3c3c5d3e5c5b05093f378e5f6d86107e87b93c7d9adb5bca5&lt;SEP&gt;chunk-218e43d49365393bf48168169286d22a5df7ee1b88b398c5561de8f95be5878f&lt;SEP&gt;chunk-866fe4ac1b993c84e8ec6b0b6c75c0299a953c019bffdef5132359bb147793f1&lt;SEP&gt;chunk-7e5101875bbe6af73647ed36abe0f23011cd57aa7a0b2cfc76e2acb7141d4d3d</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULTING LENDER&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">13.0</data>
  <data key="d5">"A Defaulting Lender does not retain certain rights and benefits as outlined in the Agreement."&lt;SEP&gt;"A Defaulting Lender's failure to meet obligations affects the conditions under which assignments can occur within the Agreement."</data>
  <data key="d6">"assignment conditions"&lt;SEP&gt;"default"</data>
  <data key="d7">chunk-0c24e69b4e8b42b6f6b510e02c4bf724c6c72f9e44ce2093b3756bf1297429de&lt;SEP&gt;chunk-7e5101875bbe6af73647ed36abe0f23011cd57aa7a0b2cfc76e2acb7141d4d3d</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULTING LENDER&quot;" target="&quot;LENDER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"A Defaulting Lender is still categorized as a Lender but operates under different obligations due to its failure to meet funding responsibilities."&lt;SEP&gt;"If one lender fails to meet its obligations, it affects the responsibilities of the other lenders involved in the agreement."</data>
  <data key="d6">"obligation impact"&lt;SEP&gt;3</data>
  <data key="d7">chunk-866fe4ac1b993c84e8ec6b0b6c75c0299a953c019bffdef5132359bb147793f1&lt;SEP&gt;chunk-0a4b11d9d570dfb94869367bf658bbf44c8a288c83406b056f2db68067634598</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULTING LENDER&quot;" target="&quot;REQUIRED LENDERS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Defaulting Lender's advances and commitment are excluded when determining Required Lenders."</data>
  <data key="d6">"exclusion"</data>
  <data key="d7">chunk-515a1f26d42a2ffc1dced7e36195ac619bbb7de89e946f61c0ea6dedc03cb138</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BUSINESS DAY&quot;" target="&quot;EFFECTIVE DATE&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The effective date must fall on a business day to ensure that all required actions can be executed as planned."</data>
  <data key="d6">"transaction timing"</data>
  <data key="d7">chunk-0a4b11d9d570dfb94869367bf658bbf44c8a288c83406b056f2db68067634598</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;SECURITIES AND EXCHANGE COMMISSION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrower is required to file necessary reports with the Securities and Exchange Commission, ensuring transparent communication of its financial standings."</data>
  <data key="d6">"regulatory oversight relationship"</data>
  <data key="d7">chunk-dab0531fa4fcf86f70f5a6e071aafc6b5ff5db2eaa35dfe862105382145767e3</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
