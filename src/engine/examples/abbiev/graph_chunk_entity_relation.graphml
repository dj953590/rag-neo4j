</edge>
<edge source="&quot;JPMORGAN CHASE BANK, N.A.&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"JPMorgan Chase Bank, N.A. serves as the Administrative Agent, overseeing the loan agreement on behalf of the lenders."</data>
  <data key="d6">"administrative role"</data>
  <data key="d7">chunk-be2493d0103919c27e88c4d44795e6271de20e61d113f608a0e09b6a8035e77e</data>
