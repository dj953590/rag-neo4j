  <data key="d4">15.0</data>
  <data key="d5">"The Agent manages administrative functions on behalf of the Lender."&lt;SEP&gt;"The Agent manages the interactions between the Lender and the Borrower under the terms of the agreement."&lt;</data>
  <data key="d6">"Management, interaction"&lt;SEP&gt;"manages, on behalf of"</data>
  <data key="d7">chunk-557ca50e2e7ed07027fe1bc3a3d46b4aca0b92a15a8793019d9d077f72596b84&lt;SEP&gt;chunk-f1583e8d86bec46433cba76eeee6ae8e3d0cee281e57ae7251a6206ddbe83f43</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;AGENT&quot;" target="&quot;CONNECTION TAXES&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Agent manages obligations and liabilities related to Connection Taxes arising in conjunction with the Loan Document."</data>
  <data key="d6">"manages, obligations"</data>
  <data key="d7">chunk-557ca50e2e7ed07027fe1bc3a3d46b4aca0b92a15a8793019d9d077f72596b84</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LEAD ARRANGER&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Administrative Agent works in collaboration with the Lead Arranger for structuring and coordinating the loan agreement."</data>
  <data key="d6">"collaboration, structuring"</data>
  <data key="d7">chunk-597b1ede56981d624f07ccc3f1c7ed2f4536e00810d740fb60781f9e5feb7ce8</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;LEAD ARRANGER&quot;" target="&quot;SYNDICATION AGENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Lead Arranger partners with the Syndication Agent to facilitate the distribution of loan commitments among multiple lenders."</data>
  <data key="d6">"syndication, partnership"</data>
  <data key="d7">chunk-597b1ede56981d624f07ccc3f1c7ed2f4536e00810d740fb60781f9e5feb7ce8</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;JPMORGAN CHASE BANK, N.A.&quot;" target="&quot;EXISTING CREDIT AGREEMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"JPMorgan Chase Bank, N.A. serves as the administrative agent in the Existing Credit Agreement, providing oversight and compliance management."</data>
  <data key="d6">"Administrative Role"</data>
  <data key="d7">chunk-59856153649b40596d478b3e3da65ad43c5f06c034b24225cd62242ce120ef82</data>
