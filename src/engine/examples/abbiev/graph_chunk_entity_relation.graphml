<node id="&quot;ADDITIONAL FEES&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"Any extra charges that may be agreed upon between the borrower and the administrative agent beyond the standard fees outlined in the agreement."</data>
