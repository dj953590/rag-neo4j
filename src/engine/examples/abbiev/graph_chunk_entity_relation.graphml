  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;EUROCURRENCY RATE ADVANCE&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Administrative Agent manages interest rates including Eurocurrency Rate Advances, ensuring adherence to the agreement terms."</data>
  <data key="d6">"management role"</data>
  <data key="d7">chunk-59856153649b40596d478b3e3da65ad43c5f06c034b24225cd62242ce120ef82</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;MASTER AGREEMENT&quot;" target="&quot;HEDGE AGREEMENTS&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"Hedge Agreements and Master Agreements are interrelated as they govern various financial transactions based on defined terms and conditions."</data>
  <data key="d6">"Governing Relationship"</data>
  <data key="d7">chunk-f67a33f5df6562c3788421c933dfc2f1287e8f4e4596bbd09e2b3a2f360ddf57</data>
  <data key="d8">DOC-ef0ff6e2b1ed8219e449e705d6553eb1bc013ea0540e1dcb68482041f8487491</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;RESIGNATION EFFECTIVE DATE&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The resignation of the Administrative Agent takes effect on the Resignation Effective Date, marking the end of their duties under the agreement."</data>
  <data key="d6">"resignation, effective"</data>
  <data key="d7">chunk-5c5be4b86bb874c0ebcd5df3142d803b7aef8e7c1c715535d330936fe5a0dce9</data>
