<node id="&quot;REGISTRAR&quot;">
  <data key="d0">"COMPANY"</data>
  <data key="d1">"An official entity responsible for recording legal documents, including agreements related to financial transactions and credit arrangements."&lt;SEP&gt;"The Registrar of Companies in Dublin, Ireland, as defined in Section 2 of the Irish Companies Act."</data>
