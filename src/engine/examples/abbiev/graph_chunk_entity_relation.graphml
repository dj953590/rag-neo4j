</edge>
<edge source="&quot;EXHIBIT B&quot;" target="&quot;FORM OF ASSIGNMENT AND ASSUMPTION&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Exhibit B contains the Form of Assignment and Assumption related to the credit agreement."}</data>
  <data key="d6">["documentation", "contains", "credit agreement"]</data>
  <data key="d7">chunk-fc2bd6d38a427261506e79c61e760df7064ed466412b69e938b252fe5e96bd95</data>
