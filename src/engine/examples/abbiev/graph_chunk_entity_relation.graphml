  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;SYNDICATION AGENT&quot;" target="&quot;TERM FACILITY&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"MUFG Bank, Ltd. serves as the Syndication Agent for the Term Facility."</data>
  <data key="d6">"serves as, for"</data>
  <data key="d7">chunk-78950c530681eb30ebd5dd748958c0ddb8dd93b84a33af76f5beae6548792ae1</data>
