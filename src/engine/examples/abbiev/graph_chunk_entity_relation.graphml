  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;JPMORGAN CHASE BANK, N.A.&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower is responsible for repaying the loan provided by JPMorgan Chase Bank, N.A., as articulated in the agreement."</data>
  <data key="d6">"lending"</data>
  <data key="d7">chunk-be2493d0103919c27e88c4d44795e6271de20e61d113f608a0e09b6a8035e77e</data>
