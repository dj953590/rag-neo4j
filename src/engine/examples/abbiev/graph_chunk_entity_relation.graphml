</edge>
<edge source="&quot;LOCAL TIME&quot;" target="&quot;CLOSING DATE&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The closing date is set at a specific time based on the local time definitions outlined in the agreement."</data>
  <data key="d6">"time specification"</data>
  <data key="d7">chunk-0a4b11d9d570dfb94869367bf658bbf44c8a288c83406b056f2db68067634598</data>
