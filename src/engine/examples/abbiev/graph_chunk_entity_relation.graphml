<node id="&quot;NEW SENIOR NOTES&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"A financial instrument mentioned in the agreement, representing indebtedness that the Borrower may incur under the terms of the credit facility."&lt;SEP&gt;"A type of debt security issued by the Borrower as part of its financing strategy."&lt;SEP&gt;"Unsecured debt securities that the Borrower or its Subsidiaries intend to issue as part of the financing for the Allergan acquisition."</data>
  <data key="d2">chunk-8b7493bb66f0421335c6ef87034d49cf6bf9d3d02f08284e06abb442b159d239&lt;SEP&gt;chunk-218e43d49365393bf48168169286d22a5df7ee1b88b398c5561de8f95be5878f&lt;SEP&gt;chunk-cdfa67546811206c5bc91d4f4c01b35c55878522beb7caefd3c918cc7bb0e4b9</data>
