</edge>
<edge source="&quot;CREDIT PARTIES&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">17.0</data>
  <data key="d5">"The Administrative Agent acts on behalf of the Credit Parties to manage and enforce Guarantee Obligations."&lt;SEP&gt;"The Administrative Agent manages the administrative functions for the Credit Parties."&lt;![CDATA[["manages", "part of"]]&gt;</data>
  <data key="d6">"manages"&lt;SEP&gt;9</data>
