  <data key="d4">8.0</data>
  <data key="d5">"The Total Credit Exposure of a lender is defined by the unused Commitment and Revolving Credit Exposure."</data>
  <data key="d6">"defines"</data>
  <data key="d7">chunk-7621b6b0260a939bf5232c1f555700bea77e3697504b1f8c45f32dc341d78043</data>
