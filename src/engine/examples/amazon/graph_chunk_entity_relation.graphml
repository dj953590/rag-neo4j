  <data key="d0">"AGENT"</data>
  <data key="d1">"The authorized signatory representing Goldman Sachs Bank USA for the execution of the credit agreement."&lt;SEP&gt;"The individual who signed on behalf of Goldman Sachs Bank USA, serving as an authorized representative in the transaction."</data>
