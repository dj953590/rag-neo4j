</edge>
<edge source="&quot;CLOSING DATE&quot;" target="&quot;AVAILABILITY PERIOD&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Closing Date marks the beginning of the Availability Period for drawdown under the loan agreement."</data>
  <data key="d6">"loan agreement initiation"</data>
  <data key="d7">chunk-1d84bf5327876902f3776604d28990e4f49aa88044f48bb58b3bc30f26cebb13</data>
