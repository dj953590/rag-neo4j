<node id="&quot;REPRESENTATIONS AND WARRANTIES&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Assertions made by parties about their legal and financial status within the agreement."&lt;SEP&gt;"Representations and Warranties refer to statements made by the parties in the Loan Document that are validated and relied upon throughout the duration of the agreement."</data>
  <data key="d2">chunk-70b37914c7be727f7cf3b7debe72de6fc09c9ea0cb16e42c919b83d6539e6663&lt;SEP&gt;chunk-d3587aca38cbbccd56f1fd8186430321564433bb032d54890f0c181d19e314d2</data>
