</node>
<node id="&quot;DESIGNATED BORROWERS&quot;">
  <data key="d0">"BORROWER"</data>
  <data key="d1">"Borrower entities specifically named in the agreement."&lt;SEP&gt;"Designated Borrowers are the entities receiving loans under the terms specified in the Agreement."&lt;SEP&gt;"Refers to specific entities that have obligations under the agreements guaranteed by the Company in favor of the Credit Parties."&lt;SEP&gt;"The party or parties identified to borrow under the terms of the credit agreement."</data>
  <data key="d2">chunk-fdd13e9cff4b44f1f996d575f0a8ec72755a2ea622bac476546165cd09900b02&lt;SEP&gt;chunk-417eddcd0bab337766c282a68bfd9bea2d8a4343e248436f5d44e16731bcff52&lt;SEP&gt;chunk-d3587aca38cbbccd56f1fd8186430321564433bb032d54890f0c181d19e314d2&lt;SEP&gt;chunk-84af9ccbe90a9c103a2c2207e81856f09e401bfac4b87201be77e022b1fada1d</data>
