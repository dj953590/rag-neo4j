  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;RESERVE REQUIREMENTS&quot;" target="&quot;LENDER&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Reserve Requirements are regulations that require Lenders to hold a certain amount of funds in reserve, affecting the credit agreement."</data>
  <data key="d6">"regulatory, compliance, risk"</data>
  <data key="d7">chunk-eeefb9b088abc8d89a40d93af5939ed01899b461f9a1e8dbd62765acc3ca0f5c</data>
