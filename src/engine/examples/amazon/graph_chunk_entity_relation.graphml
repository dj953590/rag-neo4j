  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;RECIPIENT&quot;" target="&quot;GOVERNMENTAL AUTHORITY&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Governmental Authority enforces regulations that govern financial transactions, including the imposition of Taxes related to obligations."</data>
