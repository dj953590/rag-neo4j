<node id="&quot;BASE RATE LOAN&quot;">
  <data key="d0">"FACILITY"</data>
  <data key="d1">"A Loan characterized as being based on a specified base interest rate."&lt;SEP&gt;"A loan that bears interest calculated based on the Base Rate, demonstrating a direct relationship with the Base Rate's calculation."&lt;SEP&gt;"A type of loan under which interest is calculated based on a specified base rate."</data>
  <data key="d2">chunk-7e5aa2c03b189bfa8ef483975b0359e291d82a6beb7efd71f9e1fbd8af45fe4e&lt;SEP&gt;chunk-da46c95846f2396c5682577e92deca4c73d269171539541fd3c2fb180afeee6b&lt;SEP&gt;chunk-7621b6b0260a939bf5232c1f555700bea77e3697504b1f8c45f32dc341d78043</data>
