  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CLOSING DATE&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">15.0</data>
  <data key="d5">"The Administrative Agent ensures that all documentation is received by the Closing Date to finalize the loan process."&lt;SEP&gt;"The Administrative Agent must provide documentation prior to the Closing Date to avoid tax liabilities."&lt;</data>
  <data key="d6">"Documentation Timing Requirement"&lt;SEP&gt;"Finalization, Coordination"</data>
  <data key="d7">chunk-4f31f96e5682ddadfdc80be4b7efef61d0dfdf44959082fa3a3c9f64c0ee82e8&lt;SEP&gt;chunk-85ef6ac5a1c6b87ea330f630646059e0bb68c988df4982313a1ca1446ecc64c5</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CLOSING DATE&quot;" target="&quot;LOAN DOCUMENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Closing Date marks the official execution of the Loan Document."&lt;</data>
  <data key="d6">["execution", "timeline"]</data>
  <data key="d7">chunk-e19eeb4d91d88a819da58ff7f22334afcbd8b4e79c861858ec896b44ba553485</data>
