</edge>
<edge source="&quot;TERM CORRA LOANS&quot;" target="&quot;LOAN&quot;">
  <data key="d4">10.0</data>
  <data key="d5">"Term CORRA Loans are a type of Loan"</data>
  <data key="d6">"loan type"</data>
  <data key="d7">chunk-21e8bd401eb8d2893cda3131348d5d8ecee9345959902e114ca131d8e2d1d670</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
