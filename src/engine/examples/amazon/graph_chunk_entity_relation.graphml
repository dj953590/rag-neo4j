  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;TERM CORRA TRANSITION EVENT&quot;" target="&quot;LOAN DOCUMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The occurrence of a Term CORRA Transition Event leads to necessary amendments in the Loan Document."</data>
  <data key="d6">"event, amendment"</data>
