</node>
<node id="&quot;TIBO SCREEN RATE&quot;">
  <data key="d0">"INTEREST RATE"</data>
  <data key="d1">"The TIBO Screen Rate, with respect to any Loan or Borrowing denominated in Yen."&lt;SEP&gt;"a rate per annum equal to the Tokyo interbank offered rate administered by the Ippan Shadan Hojin JBA TIBOR Administration for deposits in Yen for the applicable period."</data>
  <data key="d2">chunk-683730b045acd1f370fdaed2c7829337a50090b5804d74bf2b26500077b12189&lt;SEP&gt;chunk-16d059b04c3c34c79db1af5764af3652c9055fb5249d1bffe7a5c78ec492c07d</data>
