  <data key="d6">"triggers"</data>
  <data key="d7">chunk-cef6c7eda3071071cce06d8e7b726e368033b7ce81b07f5413f242a12d56ea76</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CHANGE IN LAW&quot;" target="&quot;DODD-FRANK WALL STREET REFORM AND CONSUMER PROTECTION ACT&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Dodd-Frank Act is categorized as a Change in Law impacting the Agreement's compliance requirements."</data>
  <data key="d6">"impacts"</data>
  <data key="d7">chunk-cef6c7eda3071071cce06d8e7b726e368033b7ce81b07f5413f242a12d56ea76</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CHANGE IN LAW&quot;" target="&quot;BANK FOR INTERNATIONAL SETTLEMENTS&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The regulations set forth by the Bank for International Settlements are considered a Change in Law under the Agreement."</data>
  <data key="d6">"influences"</data>
  <data key="d7">chunk-cef6c7eda3071071cce06d8e7b726e368033b7ce81b07f5413f242a12d56ea76</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;CHANGE IN LAW&quot;" target="&quot;BASEL COMMITTEE ON BANKING SUPERVISION&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The directives from the Basel Committee on Banking Supervision are also considered a Change in Law."</data>
  <data key="d6">"affects"</data>
