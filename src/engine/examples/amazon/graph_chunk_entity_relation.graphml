</node>
<node id="&quot;DEAL-AWAY FEES&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"Deal-away Fees are expenses incurred in connection with alternate transaction arrangements that differ from standard lending agreements."</data>
