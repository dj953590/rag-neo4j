  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;DEFAULTING LENDER&quot;" target="&quot;COMPANY&quot;">
  <data key="d4">12.0</data>
  <data key="d5">"If any Lender is a Defaulting Lender, the Company may, at its sole expense and effort, upon notice to such Lender and the Administrative Agent, require such Lender to assign and delegate, without recourse."::</data>
  <data key="d6">"default, assignment"</data>
  <data key="d7">chunk-b9642d5dbe46eea76db5bf5d1ab9b32111e99d996ae540a37b6c308a64367cbe</data>
