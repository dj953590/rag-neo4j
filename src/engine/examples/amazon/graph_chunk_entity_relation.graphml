  <data key="d0">"REGULATION"</data>
  <data key="d1">"A type of legislation that allows for the bail-in of financial institutions."&lt;SEP&gt;"the implementing law, regulation, rule or requirement for any EEA Member Country or the United Kingdom that is described in the EU Bail-In Legislation Schedule"</data>
  <data key="d2">chunk-c610acc60b313ab2f0cb1618c5c144d079538d57f099e41f83a5a06f84e38ca5&lt;SEP&gt;chunk-5c8ccb9ae0ce6b50448d0662187cdebe651dfc72a75e420e155916a8d69201a4</data>
