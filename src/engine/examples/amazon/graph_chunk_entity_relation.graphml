<node id="&quot;BANK OF AMERICA N.A.&quot;">
  <data key="d0">"LENDER"</data>
  <data key="d1">"Bank of America N.A. is identified as the lender providing financing in the revolting credit agreement with Amazon.com, Inc."</data>
