</edge>
<edge source="&quot;PAYMENTS&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Administrative Agent oversees the distribution and reclamation of Payments, ensuring adherence to agreements."</data>
  <data key="d6">"Oversight, Payment Management"</data>
