<node id="&quot;AMENDMENTS&quot;">
  <data key="d0">"AMENDMENT"</data>
  <data key="d1">"Amendments refer to the changes made to this Agreement, and are subject to the consent of the Required Lenders and the Administrative Agent."&lt;SEP&gt;"Formal changes or modifications to the agreement."</data>
