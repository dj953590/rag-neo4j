</edge>
<edge source="&quot;NOTE&quot;" target="&quot;LOAN DOCUMENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Loan Document includes the Note, which is a facility outlined in the agreement."</data>
  <data key="d6">"document inclusion"</data>
  <data key="d7">chunk-e56521f0d5861a7f4d9b333237148742c844e3d8c2104929a676973533b40aca</data>
