  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;NOTE&quot;" target="&quot;LOAN DOCUMENTS&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Note is a document that evidences the Loan and is part of the Loan Documents."::</data>
  <data key="d6">"loan documentation, evidence, obligation"</data>
