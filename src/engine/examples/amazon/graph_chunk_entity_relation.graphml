</node>
<node id="&quot;TERMINATION; REINSTATEMENT&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Conditions under which a guaranty may be terminated or reinstated."&lt;SEP&gt;"Conditions under which the guaranty can be terminated or reinstated."</data>
  <data key="d2">chunk-92bc0ef3487c16027d11fdb4cbf49715366ff7c084aef20af5c7f4783257a7f3</data>
