<node id="&quot;INDEMNITY&quot;">
  <data key="d0">"FINANCIAL"</data>
  <data key="d1">"A guarantee or assurance to compensate for losses or damages."&lt;SEP&gt;"The Company shall not exercise any right of subrogation, contribution, indemnity, reimbursement or similar rights."</data>
