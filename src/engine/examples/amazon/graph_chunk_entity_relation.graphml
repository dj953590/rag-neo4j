</node>
<node id="&quot;PTE&quot;">
  <data key="d0">"REGULATORY"</data>
  <data key="d1">"A prohibited transaction class exemption issued by the U.S. Department of Labor, potentially subject to amendments."</data>
  <data key="d2">chunk-42d0ef1a853dfae1ebeda59d8a271d919e3401384ff07dde2d60832a2bc531d0</data>
