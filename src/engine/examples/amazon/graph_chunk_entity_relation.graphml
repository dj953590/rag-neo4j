  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;NOTICES&quot;" target="&quot;AMENDMENTS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Amendments to the agreement require effective notice procedures as outlined in the document."</data>
  <data key="d6">"modification, notification"</data>
  <data key="d7">chunk-2b7f66d77f5bfe9a6d041600c174e6e10c32cc8795bc4e86ae5ad61eb30b411c</data>
