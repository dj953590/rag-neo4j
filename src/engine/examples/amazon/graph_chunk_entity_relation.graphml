</node>
<node id="&quot;NATIONAL WESTMINSTER BANK PLC&quot;">
  <data key="d0">"LENDER"</data>
  <data key="d1">"A UK-based lender included in the lending consortium for the credit agreement."&lt;SEP&gt;"National Westminster Bank Plc is the lender in the five-year revolving credit agreement with AMAZON.COM, INC."</data>
