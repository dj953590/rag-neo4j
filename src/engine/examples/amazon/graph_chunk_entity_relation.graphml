<edge source="&quot;REQUIRED LENDERS&quot;" target="&quot;COMPANY&quot;">
  <data key="d4">18.0</data>
  <data key="d5">"Company requires consent from Required Lenders for any amendments or modifications to its obligations."&lt;SEP&gt;"The Company must gain the written consent of the Required Lenders to remove or appoint the Administrative Agent, indicating a collaborative relationship."&lt;&lt;SEP&gt;"The Required Lenders must consent to the appointment of a successor Administrative Agent when the current agent resigns."</data>
  <data key="d6">"approval, appointment"&lt;SEP&gt;"requires consent"&lt;SEP&gt;consent, governance&lt;</data>
