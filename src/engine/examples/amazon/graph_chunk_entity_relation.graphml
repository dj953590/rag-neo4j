</edge>
<edge source="&quot;GOVERNMENTAL AUTHORITY&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Administrative Agent is responsible for timely paying withheld or deducted taxes to the relevant Governmental Authority."</data>
  <data key="d6">"payment, compliance"</data>
  <data key="d7">chunk-671f3b38bd6c6bb7fc6cb71e54f93c1747efdf0e7d1d512d7b432bf2cb859443</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;GOVERNMENTAL AUTHORITY&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">15.0</data>
  <data key="d5">"The Borrower must pay Other Taxes to the Governmental Authority according to applicable laws."&lt;SEP&gt;"The Borrower’s execution of the Agreement does not need any approval from Governmental Authority."</data>
  <data key="d6">"execution, approval"&lt;SEP&gt;"payment, regulatory compliance"</data>
  <data key="d7">chunk-671f3b38bd6c6bb7fc6cb71e54f93c1747efdf0e7d1d512d7b432bf2cb859443&lt;SEP&gt;chunk-ed45c6c96103ab059aceb21c9095ebdb108ab095fa5004a7e6ef0bf873513bc6</data>
