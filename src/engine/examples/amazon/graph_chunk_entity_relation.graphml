  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;GOVERNMENTAL AUTHORITY&quot;" target="&quot;PERSON&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The Person is subject to regulations and oversight by the Governmental Authority in fulfilling its obligations."</data>
  <data key="d6">"Regulatory Oversight"</data>
  <data key="d7">chunk-84af9ccbe90a9c103a2c2207e81856f09e401bfac4b87201be77e022b1fada1d</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
