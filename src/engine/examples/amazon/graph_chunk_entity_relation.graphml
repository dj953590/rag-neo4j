</edge>
<edge source="&quot;PAYMENTS&quot;" target="&quot;LENDER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Lenders receive payments which are subject to error and must be managed according to agreement terms."</data>
  <data key="d6">"Payment Management, Lender Responsibilities"</data>
