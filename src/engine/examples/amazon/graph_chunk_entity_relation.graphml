<node id="&quot;FOREIGN LENDER&quot;">
  <data key="d0">"LENDER"</data>
  <data key="d1">"A lender that is not a U.S. Person, providing loans to a Borrower who is a U.S. Person or vice versa, as defined in the agreement."&lt;SEP&gt;"Any entity providing loans under the Agreement that claims benefits from U.S. tax treaties or exemptions as stipulated in the Loan Documents."</data>
