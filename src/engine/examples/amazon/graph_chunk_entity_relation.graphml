  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;TOTAL CREDIT EXPOSURE&quot;" target="&quot;TOTAL OUTSTANDINGS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Total Outstandings reflects the aggregate amount of all Loans corresponding to the Total Credit Exposure."</data>
  <data key="d6">"reflects"</data>
  <data key="d7">chunk-7621b6b0260a939bf5232c1f555700bea77e3697504b1f8c45f32dc341d78043</data>
