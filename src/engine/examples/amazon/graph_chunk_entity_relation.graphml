<node id="&quot;AUD SCREEN RATE&quot;">
  <data key="d0">"BASE RATE BENCHMARK"</data>
  <data key="d1">"AUD Screen Rate means a rate per annum equal to the average bid reference rate administered by ASX Benchmark Pty Limited for bills of exchange in Australian Dollars."&lt;SEP&gt;"the relevant benchmark rate for loans or borrowings denominated in Australian Dollars."</data>
  <data key="d2">chunk-1d84bf5327876902f3776604d28990e4f49aa88044f48bb58b3bc30f26cebb13&lt;SEP&gt;chunk-3a2d758478b0cf8155d3e94a751c2840e54bd5bf20d852453683cc7e4c195406</data>
