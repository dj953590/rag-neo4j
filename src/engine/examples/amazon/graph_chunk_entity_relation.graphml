<node id="&quot;GREGORY T. MARTIN&quot;">
  <data key="d0">"AGENT"</data>
  <data key="d1">"An executive director at JPMorgan Chase Bank, N.A. involved in the signing of the credit agreement."&lt;SEP&gt;"The individual who has the authority to execute and sign the revolving credit agreement on behalf of the lender."</data>
  <data key="d2">chunk-ed2f3a42b192f01bd28081a0632d42d57d7e934196ff7035d9d4662789e4d97f</data>
