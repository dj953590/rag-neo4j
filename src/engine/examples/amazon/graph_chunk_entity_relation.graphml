</node>
<node id="&quot;EEA MEMBER COUNTRY&quot;">
  <data key="d0">"COMPANY"</data>
  <data key="d1">"Any of the member states of the European Union, Iceland, Liechtenstein, and Norway."</data>
  <data key="d2">chunk-8d506667a8395aa3be8c9d19bd89c9e9e050e1c599089f07ada478b9b6ee4079</data>
