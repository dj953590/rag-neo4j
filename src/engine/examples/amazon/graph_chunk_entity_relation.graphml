  <data key="d0">"AGENT"</data>
  <data key="d1">"My-Linh Yoshiike is the Vice President at BNP Paribas also involved in the agreement signing."&lt;SEP&gt;"My-Linh Yoshiike is the Vice President representing BNP Paribas in the credit agreement."</data>
