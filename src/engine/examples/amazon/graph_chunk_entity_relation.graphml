<node id="&quot;EUROPEAN UNION&quot;">
  <data key="d0">"REGULATORY"</data>
  <data key="d1">"The European Union is a political and economic union of European countries."&lt;SEP&gt;"The economic and political union of European countries that has the Euro as its lawful currency."&lt;SEP&gt;"a supra-national body that exercises governmental authority."&lt;SEP&gt;"an economic and political union of 27 European countries"&lt;SEP&gt;"any sanction administered or enforced by the European Union"</data>
  <data key="d2">chunk-4b0b12585f6502351b0e84ecc60e47e6640828e4339d67c9b7a3c5084dcdb713&lt;SEP&gt;chunk-3dff3b153ec45df711dfc884145e6bd8e5c94c750ec4b6a3dfc30192713432e6&lt;SEP&gt;chunk-523b7c35f39a59c5cfa19ecb52fd1a59b812fc7d6cb057106fe0660553c4d72c&lt;SEP&gt;chunk-f6e8743e0fed11cf1e7302388e7b8f38f70918d5b087d464be884bffcad84ea3&lt;SEP&gt;chunk-652de4f4d91e90a6f7563949dee043c59ebc83c69af5a7e4daaf8634d33d43cd</data>
