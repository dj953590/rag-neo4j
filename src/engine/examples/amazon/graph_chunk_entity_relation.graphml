</node>
<node id="&quot;ADMINISTRATION OF THE AGREEMENT&quot;">
  <data key="d0">"AGENT"</data>
  <data key="d1">"Administration of the Agreement includes the oversight and management of all activities and transactions carried out under the Agreement."</data>
