  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;EXHIBIT D-1&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Foreign Lender must submit Exhibit D-1 to confirm their tax status as part of the tax compliance process.")</data>
  <data key="d6">documentation"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;EXHIBIT D-2&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Exhibit D-2 is submitted by the Foreign Lender to establish tax compliance under U.S. law.")</data>
  <data key="d6">documentation"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;EXHIBIT D-3&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The Foreign Lender must provide Exhibit D-3 as necessary compliance documentation required for tax processes.")</data>
  <data key="d6">documentation"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;EXHIBIT D-4&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"If applicable, the Foreign Lender submits Exhibit D-4 to provide necessary tax certification for its partners.")</data>
  <data key="d6">certification"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;SECTION 881(C)&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Foreign Lender must claim the portfolio interest exemption as stipulated in Section 881(c) of the Code.")</data>
  <data key="d6">exemption"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;SECTION 1471&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Foreign Lender is responsible for compliance with the reporting requirements under Section 1471 of the Code.")</data>
  <data key="d6">regulation"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;U.S. FEDERAL WITHHOLDING TAX&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Payments to the Foreign Lender may be subject to U.S. federal withholding Tax which must be managed according to compliance requirements.")</data>
  <data key="d6">tax management"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;FOREIGN LENDER&quot;" target="&quot;PORTFOLIO INTEREST EXEMPTION&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Foreign Lender claims the portfolio interest exemption to mitigate U.S. tax liabilities on interest payments.")</data>
  <data key="d6">tax exemption"</data>
  <data key="d7">chunk-71926bba5cc37a2755872e00f76b4d781b7e713080d4f728381fb8c26ebe6239</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;OVERNIGHT RATE&quot;" target="&quot;OBLIGATIONS&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Obligations may incur interest calculated at the Overnight Rate in case of late payment or recovery."</data>
  <data key="d6">["interest calculation", "financial obligations"]</data>
  <data key="d7">chunk-9b8991cd9ed9ee197640df0ae2da83d3076642e19ac632e7680d69e182501d14</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;OVERNIGHT RATE&quot;" target="&quot;BORROWERS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Borrowers may incur interest charges based on the Overnight Rate for any outstanding amounts from erroneous Payments."</data>
  <data key="d6">"Interest Charges, Payment Resolution"</data>
  <data key="d7">chunk-6f39409ba6af7be45cd3c173570b9a98e697daf7a50e484fb20109ec77dceb60</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;NEW YORK&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Agreement outlines that any legal actions should be initiated in New York as the designated jurisdiction."</data>
  <data key="d6">"jurisdiction"</data>
  <data key="d7">chunk-93274523ea8cfdffe9cb49b239093b9b8fd8cc1fcabcf6c7085087dd7bd81fff</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;PRINCIPAL&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Borrowers are required to repay the Principal amount along with any accrued interest under the terms of their Loan Agreement."</data>
  <data key="d6">"loan repayment, principal"</data>
  <data key="d7">chunk-f666304f992508904d45fa90a054cf11c70cca631bd29a119dce648d89514bc1</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;INTEREST&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrowers must pay interest on the amounts borrowed, which is a cost incurred for accessing loan funds."</data>
  <data key="d6">"cost of borrowing, repayment terms"</data>
  <data key="d7">chunk-f666304f992508904d45fa90a054cf11c70cca631bd29a119dce648d89514bc1</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;LENDER&quot;">
  <data key="d4">44.0</data>
  <data key="d5">"Each Lender agrees to make loans to the Borrowers as per the terms set in the Agreement."&lt;SEP&gt;"Lenders are responsible for managing relationships and financial obligations with Borrowers concerning Payments."&lt;SEP&gt;"Lenders require Borrowers to provide information to comply with the USA PATRIOT Act."&lt;&lt;SEP&gt;"The Borrowers are obligated to repay the Loans provided by the Lender under specified terms, including payment conditions and currencies."&lt;SEP&gt;"The Borrowers are receiving a Loan from the Lender according to the credit agreement."</data>
  <data key="d6">"Responsibility, Financial Relationship"&lt;SEP&gt;"loan agreement"&lt;SEP&gt;"provides financing"&lt;SEP&gt;"repayment obligation"&lt;SEP&gt;"requirement, identity verification"</data>
  <data key="d7">chunk-6f39409ba6af7be45cd3c173570b9a98e697daf7a50e484fb20109ec77dceb60&lt;SEP&gt;chunk-ce8b2ab918bc2ac2fae1fd5cbd9e379e3b29035370465def38ddf18fc7e593eb&lt;SEP&gt;chunk-e31400f903fff2f32b0dd2b881155af0546c26f3e025fb7e6299c51e9e9e0922&lt;SEP&gt;chunk-769e42748a143e5fd0e034379f2dad5901f83bf76944aa4d070cbf73095a334a&lt;SEP&gt;chunk-a1802684c18fb32d6b6b57dfc8ae152b1f62a6d7e7db1fb9e15d0b2ec9c21a9c</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;LOAN&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrowers receive financing through Loans structured under the terms of the Agreement."</data>
  <data key="d6">"receives funds"</data>
  <data key="d7">chunk-769e42748a143e5fd0e034379f2dad5901f83bf76944aa4d070cbf73095a334a</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;ALTERNATIVE CURRENCY&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"If prohibited from making payments in US Dollars, Borrowers may utilize Alternative Currency to fulfill their payment obligations under specific conditions."</data>
  <data key="d6">"payment flexibility"</data>
  <data key="d7">chunk-a1802684c18fb32d6b6b57dfc8ae152b1f62a6d7e7db1fb9e15d0b2ec9c21a9c</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">17.0</data>
  <data key="d5">"Borrowers are defined within the Agreement as the entities receiving the loans and must satisfy specified conditions to access funds."&lt;SEP&gt;"The Borrowers are bound by the terms set forth in the Agreement, which outlines their obligations regarding repayment and compliance."</data>
  <data key="d6">"Obligation, Compliance"&lt;SEP&gt;"loan, conditions"</data>
  <data key="d7">chunk-4f31f96e5682ddadfdc80be4b7efef61d0dfdf44959082fa3a3c9f64c0ee82e8&lt;SEP&gt;chunk-f666304f992508904d45fa90a054cf11c70cca631bd29a119dce648d89514bc1</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">40.0</data>
  <data key="d5">"Borrowers acknowledge that erroneous Payments do not satisfy their obligations under the agreements."&lt;SEP&gt;"The Administrative Agent coordinates with the Borrowers to facilitate the loan process and ensure that all terms of the Agreement are met."&lt;SEP&gt;"The Administrative Agent exchanges information and ensures compliance with regulations among Borrowers."&lt;&lt;SEP&gt;"The Administrative Agent facilitates payment processing from the Borrowers to the respective Lenders, ensuring timely transactions according to agreements."&lt;SEP&gt;"The Administrative Agent notifies the Borrowers regarding the status of their loans and Aggregate Commitments, prompting action from the Borrowers if necessary."&lt;SEP&gt;"The administrative agent acts as a liaison between the lender and the borrowers, managing communication and loan terms."}</data>
  <data key="d6">"Loan Coordination, Facilitation"&lt;SEP&gt;"Obligation, Acknowledgment"&lt;SEP&gt;"communication management"&lt;SEP&gt;"compliance, regulation"&lt;SEP&gt;"facilitates, manages payments"&lt;SEP&gt;"notification, management"</data>
  <data key="d7">chunk-4f31f96e5682ddadfdc80be4b7efef61d0dfdf44959082fa3a3c9f64c0ee82e8&lt;SEP&gt;chunk-2997033e9e9586a5d8ae522596b79da333d35edef15546a52e86c722b6d5025e&lt;SEP&gt;chunk-6f39409ba6af7be45cd3c173570b9a98e697daf7a50e484fb20109ec77dceb60&lt;SEP&gt;chunk-e31400f903fff2f32b0dd2b881155af0546c26f3e025fb7e6299c51e9e9e0922&lt;SEP&gt;chunk-ae141e7df14e0e4a6e6cc20f2d0ae5a460cfdb6b5bada2b428f3a3fa46ab9962&lt;SEP&gt;chunk-a1802684c18fb32d6b6b57dfc8ae152b1f62a6d7e7db1fb9e15d0b2ec9c21a9c</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;AGGREGATE COMMITMENTS&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrowers must adhere to the limits of the Aggregate Commitments when making borrowings and repayments."</data>
  <data key="d6">"obligation, adherence"</data>
  <data key="d7">chunk-2997033e9e9586a5d8ae522596b79da333d35edef15546a52e86c722b6d5025e</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;ALTERNATIVE CURRENCY SUBLIMIT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrowers need to manage their loans such that the Outstanding Amount in alternative currencies does not exceed the Alternative Currency Sublimit."</data>
  <data key="d6">"management, compliance"</data>
  <data key="d7">chunk-2997033e9e9586a5d8ae522596b79da333d35edef15546a52e86c722b6d5025e</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;LOANS&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Loans represent the financing that the Borrowers are entitled to under the terms of the agreement, reflecting the financial relationship between the two entities."</data>
  <data key="d6">"financing"</data>
  <data key="d7">chunk-2997033e9e9586a5d8ae522596b79da333d35edef15546a52e86c722b6d5025e</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;DESIGNATED BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Borrowers are those entities specifically designated to access financing under the terms of the Loan Agreement."</data>
  <data key="d6">"loan access, designations"</data>
  <data key="d7">chunk-f666304f992508904d45fa90a054cf11c70cca631bd29a119dce648d89514bc1</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;BORROWING&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Borrowers are entities that enter into Borrowing agreements to receive financial obligations under the loan terms."</data>
  <data key="d6">"receives, enters into"</data>
  <data key="d7">chunk-6b1ab24691979572d7f7f2a1bf500f4f9f0a1ef9c39b332d7a9134e52664d46c</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;ADMINISTRAVE AGENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Administrative Agent demands Regulatory Information from Borrowers to comply with ongoing legal obligations."&lt;</data>
  <data key="d6">"demand, compliance"</data>
  <data key="d7">chunk-e31400f903fff2f32b0dd2b881155af0546c26f3e025fb7e6299c51e9e9e0922</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;REGULATORY INFORMATION&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Borrowers are obligated to provide Regulatory Information to the Administrative Agent upon reasonable request."&lt;</data>
  <data key="d6">"obligation, information provision"</data>
  <data key="d7">chunk-e31400f903fff2f32b0dd2b881155af0546c26f3e025fb7e6299c51e9e9e0922</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;PAYMENTS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Borrowers agree that Payments received in error do not satisfy their obligations owing under the credit agreement."</data>
  <data key="d6">"Obligation, Payment Acknowledgment"</data>
  <data key="d7">chunk-6f39409ba6af7be45cd3c173570b9a98e697daf7a50e484fb20109ec77dceb60</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;TERM BENCHMARK LOANS&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"The borrowers take out term benchmark loans from the lender, which they are expected to repay according to the terms specified."}</data>
  <data key="d6">"loan agreement"</data>
  <data key="d7">chunk-ae141e7df14e0e4a6e6cc20f2d0ae5a460cfdb6b5bada2b428f3a3fa46ab9962</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;BASE RATE LOANS&quot;">
  <data key="d4">1.0</data>
  <data key="d5">"Borrowers are required to repay base rate loans provided by the lender under specified conditions."}</data>
  <data key="d6">"repayment obligation"</data>
  <data key="d7">chunk-ae141e7df14e0e4a6e6cc20f2d0ae5a460cfdb6b5bada2b428f3a3fa46ab9962</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;ACCOUNTS RECEIVABLE&quot;" target="&quot;AMAZON SELLER LENDING FACILITY&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Liens on accounts receivable are created in relation to financing facilitated by the Amazon Seller Lending Facility."</data>
  <data key="d6">"financing, collateral"</data>
  <data key="d7">chunk-55848c3f3528776bc10163e1eae281a9a0245264a349b24750774dd15c19274c</data>
  <data key="d8">DOC-5619df3ed8174d0d8a59a7c69c0d2e4d08b31bfa20e08b964330e5d3d2b5c6eb</data>
  <data key="d9">&lt;r&gt;</data>
</edge>
<edge source="&quot;SOUTHERN DISTRICT OF NEW YORK&quot;" target="&quot;AGREEMENT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Agreement provides for claims to be determined in the Southern District of New York federal court."</data>
