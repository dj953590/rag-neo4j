<node id="&quot;TERMINATION OR REDUCTION OF COMMITMENTS&quot;">
  <data key="d0">"COMMITMENT"</data>
  <data key="d1">"The Termination or Reduction of Commitments refers to the lender's right to terminate or reduce their commitment to provide financing under the credit agreement."</data>
