</node>
<node id="&quot;OTHER PERMITTED LIENS&quot;">
  <data key="d0">"LIEN"</data>
  <data key="d1">"Liens that are allowed on property or assets of the Company or its Subsidiaries under specific conditions, ensuring compliance with financial regulations."&lt;SEP&gt;"Liens that are allowed under specific conditions and do not encumber properties other than the ones specifically associated with them."</data>
  <data key="d2">chunk-55848c3f3528776bc10163e1eae281a9a0245264a349b24750774dd15c19274c&lt;SEP&gt;chunk-5a5d78065cc3e41a4cd16e57e1ecf2b9dd7b8c5201ec5228cb8a44ad16102890</data>
