</edge>
<edge source="&quot;UK RESOLUTION AUTHORITY&quot;" target="&quot;UK FINANCIAL INSTITUTION&quot;">
  <data key="d4">18.0</data>
  <data key="d5">"A UK Financial Institution is subject to the resolution authority of the UK Resolution Authority."</data>
