<node id="&quot;GUARANTEE&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"A guarantee is an agreement by the guarantor to pay the borrower's obligations."&lt;SEP&gt;"any obligation, contingent or otherwise, of such Person guaranteeing or having the economic effect of guaranteeing any Indebtedness or other obligation payable or performable by another Person."</data>
  <data key="d2">chunk-f235e3aaffeb5cbfa776ab6ea080fa76cc39f67d3014cd035759653e27770f28&lt;SEP&gt;chunk-652de4f4d91e90a6f7563949dee043c59ebc83c69af5a7e4daaf8634d33d43cd</data>
