</node>
<node id="&quot;NEW YORK&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"New York is the specified judicial location for any legal actions arising from this Agreement or related loan documents."</data>
  <data key="d2">chunk-93274523ea8cfdffe9cb49b239093b9b8fd8cc1fcabcf6c7085087dd7bd81fff</data>
