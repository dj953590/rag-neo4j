<edge source="&quot;MARKET PRACTICE&quot;" target="&quot;ADMINISTRATIVE AGENT&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Administrative Agent ensures the implementation of market practices in the adjustments made for the Benchmark Replacement."</data>
  <data key="d6">"ensures compliance with"</data>
