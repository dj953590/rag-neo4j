    <node id="&quot;NON-CONSENTING LENDER&quot;">
      <data key="d0">"CLIENT"</data>
      <data key="d1">"A Non-Consenting Lender is a lender that does not agree to certain amendments or consents outlined in the loan documents."&lt;SEP&gt;"Non-Consenting Lender refers to a lender that does not approve certain changes or amendments in loan agreements."</data>
