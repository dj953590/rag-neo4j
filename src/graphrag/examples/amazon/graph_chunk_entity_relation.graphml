  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Legal standards that guide the judgment in cases involving fairness, as opposed to strict legal rules."</data>
  <data key="d2">chunk-f878f9bb708e5f123411182579bddcb8</data>
</node>
<node id="&quot;RESOLUTION AUTHORITY&quot;">
  <data key="d0">"AGENCY"</data>
