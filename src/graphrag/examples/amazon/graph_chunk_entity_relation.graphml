    <node id="&quot;ANCILLARY DOCUMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ancillary Documents include all additional documents that relate to the primary loan agreement and its execution."</data>
      <data key="d2">chunk-2628557ba1269917afefe40986b27b9f</data>
    </node>
    <node id="&quot;WELLS FARGO SECURITIES, LLC.&quot;">
