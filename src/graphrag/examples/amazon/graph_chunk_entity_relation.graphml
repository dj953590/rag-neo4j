</node>
<node id="&quot;TOTAL CREDIT EXPOSURE&quot;">
  <data key="d0">"FINANCIAL METRIC"</data>
  <data key="d1">"Total Credit Exposure represents the combination of a lender's unused commitment and revolving credit exposure."</data>
  <data key="d2">chunk-d66da8a55a9bfe53a234f03c63fcb1d0</data>
</node>
<node id="&quot;EXTENDING LENDER&quot;">
