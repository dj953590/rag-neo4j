  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Counterparts refer to the copies of the Agreement that bear the signatures of each party."&lt;SEP&gt;"Counterparts refer to the multiple copies of the Agreement that can be signed by different parties, constituting a single contract."&lt;SEP&gt;"Section 11.10 indicates that the agreement can be executed in counterparts."</data>
  <data key="d2">chunk-1f3ce5eef87d6ccefcbefcd4c22f900c&lt;SEP&gt;chunk-40c9da145f3e45db09eb70b219243579&lt;SEP&gt;chunk-c1eb67ffcaf5d2d9cf2ad7c51a9e64eb</data>
