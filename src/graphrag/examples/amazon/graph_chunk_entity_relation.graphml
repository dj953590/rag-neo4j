      <data key="d2">chunk-4015d17cdefaed939b54860ada7329d6&lt;SEP&gt;chunk-b7295628aa9ed592731ce2c655152923</data>
    </node>
    <node id="&quot;U.S. INTERNAL REVENUE CODE OF 1986&quot;">
      <data key="d0">"CODE"</data>
      <data key="d1">"The Code means the U.S. Internal Revenue Code of 1986."</data>
      <data key="d2">chunk-c27cff3d0a152feb2e0548cd9db039db</data>
    </node>
    <node id="&quot;MATERIAL SUBSIDIARY&quot;">
      <data key="d0">"COMPANY"</data>
      <data key="d1">"Material Subsidiary refers to a subsidiary of a parent company that is significant to the parent’s financial condition."&lt;SEP&gt;"Refers to subsidiaries of the Company that have a material impact on its financial performance and obligations."</data>
