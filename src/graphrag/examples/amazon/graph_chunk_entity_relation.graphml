    </node>
    <node id="&quot;SEVERABILITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Severability provisions allow the rest of the agreement to remain in effect even if one part is found invalid."</data>
      <data key="d2">chunk-2628557ba1269917afefe40986b27b9f</data>
    </node>
    <node id="&quot;GOLDMAN SACHS BANK USA.&quot;">
