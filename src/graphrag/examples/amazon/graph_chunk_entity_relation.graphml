  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"'Code' means the U.S. Internal Revenue Code of 1986."</data>
  <data key="d2">chunk-05b4cc5b2660656388ebad9cd016c596</data>
</node>
<node id="&quot;FASB ASC&quot;">
  <data key="d0">"REGULATORY"</data>
  <data key="d1">"'FASB ASC' means the Accounting Standards Codification of the Financial Accounting Standards Board."</data>
  <data key="d2">chunk-b187719dac182a293454abdbf819f856</data>
</node>
