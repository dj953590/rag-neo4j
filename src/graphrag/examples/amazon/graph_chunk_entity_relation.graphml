  <data key="d2">chunk-024104f61867a710efed88937d20b566</data>
</node>
<node id="&quot;SYNTHETIC LEASE OBLIGATION&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Synthetic Lease Obligation is a monetary obligation under an off-balance sheet lease or use agreement."&lt;SEP&gt;"the capitalized amount of the remaining lease payments under the relevant lease that would appear on a balance sheet if such lease were accounted for as a capital lease."</data>
  <data key="d2">chunk-213102e52aa6edea98697876f4c7a539&lt;SEP&gt;chunk-c13f8f110a52f456f7cfa34d1627fa44</data>
</node>
