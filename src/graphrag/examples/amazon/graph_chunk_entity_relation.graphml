  <data key="d2">chunk-63dba9e522714ac0a8717c04f114cbd9</data>
</node>
<node id="&quot;AGGREGATE COMMITMENTS&quot;">
  <data key="d0">"AGREEMENT"</data>
  <data key="d1">"Aggregate Commitments refer to the total amount committed by each Lender as per the agreement."&lt;SEP&gt;"Aggregate Commitments refer to the total amount that lenders are willing to provide to borrowers within a period."&lt;SEP&gt;"Refers to the total commitment amount agreed upon by Lenders for the Borrowers."&lt;SEP&gt;"The total amount committed by the Lenders to be provided as loans to the Company under the agreement."&lt;SEP&gt;"The total amount of credit that the Lenders have agreed to provide and maintain."&lt;SEP&gt;"Total amount committed by all Lenders under the loan structure."&lt;SEP&gt;"the Commitments of all the Lenders at such time, totaling US$15,000,000,000 as of the Closing Date."&lt;SEP&gt;"the Total Outstandings shall not exceed the Aggregate Commitments."&lt;SEP&gt;"the total commitments made by lenders in relation to a credit facility."</data>
  <data key="d2">chunk-f3f17cf7a579171d338315f7798375fb&lt;SEP&gt;chunk-213102e52aa6edea98697876f4c7a539&lt;SEP&gt;chunk-17156cdb19d248f88d4ee1e387dc4521&lt;SEP&gt;chunk-cfb372b965947cb79981661e12746f74&lt;SEP&gt;chunk-3407cac26fbf761cda3f472334e41a85&lt;SEP&gt;chunk-c72ac38860fa8c92501d3a2b3a580efb&lt;SEP&gt;chunk-cb93392f69f11919011ae9632eeb26aa&lt;SEP&gt;chunk-312f7b4d5463e218d8729ce3bfbd8941&lt;SEP&gt;chunk-70346a0ac74ecfe6bd503edd172112c0</data>
</node>
