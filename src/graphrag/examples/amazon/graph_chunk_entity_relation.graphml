  <data key="d2">chunk-9b1b3dbc667d28f3ba91031c5a47a78d</data>
</node>
<node id="&quot;INTEREST&quot;">
  <data key="d0">"INTEREST RATE"</data>
  <data key="d1">"The cost of borrowing, typically expressed as a percentage of the loan amount."</data>
  <data key="d2">chunk-7eb7b5bc404a25d999aedbc8e6f0cac4</data>
</node>
